---
// src/pages/standhouders.astro
// Interactieve Plattegrond & Standhouders voor Gents Whisky Festival (De Oude Vismijn Gent)
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getStandhouders } from '../lib/ghl';

const exhibitors = await getStandhouders('gent');
---

<Layout 
  title="Interactieve Plattegrond & Standhouders" 
  description="Navigeer door De Oude Vismijn Gent met onze interactieve festivalplattegrond. Vind direct waar al uw favoriete whiskymerken en standhouders zich bevinden op het Gents Whisky Festival."
>
  <!-- Navigation Header -->
  <Header />

  <main class="standhouders-page-wrapper">
    <!-- Page Header -->
    <div class="page-title-section animate-fade-in">
      <span class="page-tag">Festival Gids 2026</span>
      <h1 class="page-title">Plattegrond & Stands</h1>
      <div class="vintage-line"></div>
      <p class="page-subtitle">Verken de historische zalen van De Oude Vismijn, zoek uw favoriete merken en zie direct welke standhouder zich waar bevindt.</p>
    </div>

    <!-- Horizontal Search & Filters Bar -->
    <div class="search-filter-horizontal-bar vintage-frame animate-fade-in" style="animation-delay: 0.1s;">
      <div class="vintage-frame-inner horizontal-bar-inner">
        
        <div class="search-input-wrapper">
          <input type="text" id="exhibitor-search" class="form-control" placeholder="Zoek op standhouder of merk..." />
          <span class="search-icon-inside">
            <svg class="search-icon-svg" viewBox="0 0 24 24" width="16" height="16" stroke="var(--text-charcoal)" stroke-width="2.5" fill="none" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="11" cy="11" r="8"></circle>
              <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
            </svg>
          </span>
        </div>
        
        <div class="filter-buttons-row">
          <button type="button" class="filter-tab active" data-filter="all">Alle</button>
          <button type="button" class="filter-tab" data-filter="belgian">Belgisch</button>
          <button type="button" class="filter-tab" data-filter="scotch">Schots</button>
          <button type="button" class="filter-tab" data-filter="independent">Onafhankelijk</button>
          <button type="button" class="filter-tab" data-filter="world">Wereld</button>
          <button type="button" class="filter-tab" data-filter="catering">Food &amp; Catering</button>
        </div>

      </div>
    </div>

    <!-- Interactive Map & Detail Layout -->
    <div class="map-detail-layout animate-fade-in" style="animation-delay: 0.15s;">
      
      <!-- LEFT COLUMN: The Digital Vector Floor Plan Map of De Oude Vismijn -->
      <div class="map-visual-container vintage-frame">
        <div class="vintage-frame-inner map-scroll-area">
          <div class="map-toolbar">
            <span class="toolbar-title">Plattegrond De Oude Vismijn Gent</span>
            <div class="zoom-controls">
              <button type="button" class="zoom-btn" id="zoom-in" title="Inzoomen">＋</button>
              <button type="button" class="zoom-btn" id="zoom-out" title="Uitzoomen">－</button>
              <button type="button" class="zoom-btn" id="zoom-reset" title="Herstellen">Herstel</button>
            </div>
          </div>
          
          <div class="svg-zoom-wrapper" id="svg-zoom-target">
            <!-- 100% PURE DIGITAL VECTOR SVG MAP OF DE OUDE VISMIJN GENT (LANDSCAPE EXACT LIKE DEN HAAG) -->
            <svg viewBox="0 0 980 500" class="vismijn-svg-map" id="vismijn-map">
              <defs>
                <pattern id="pillar-pattern" width="10" height="10" patternUnits="userSpaceOnUse">
                  <circle cx="5" cy="5" r="3" fill="#D5CCA9" />
                </pattern>
                
                <pattern id="water-pattern" width="24" height="12" patternUnits="userSpaceOnUse">
                  <path d="M 0 6 Q 6 2 12 6 T 24 6" fill="none" stroke="rgba(30, 58, 138, 0.22)" stroke-width="1.3" />
                </pattern>

                <pattern id="cobble-pattern" width="12" height="12" patternUnits="userSpaceOnUse">
                  <path d="M 0 6 L 6 0 L 12 6 L 6 12 Z" fill="none" stroke="rgba(140, 115, 80, 0.12)" stroke-width="0.8" />
                </pattern>
              </defs>

              <!-- Blueprint grid / transparent canvas -->
              <rect width="980" height="500" fill="transparent" />

              <!-- ============================================== -->
              <!-- EXTERIOR WATERWAYS: DE LEIE & DE LIEVE -->
              <!-- ============================================== -->
              <!-- River De Leie (Top-Left Water Area) -->
              <path d="M 50 140 Q 110 50 240 50 L 240 78 Q 130 78 78 160 Z" fill="#E2EAF8" opacity="0.9" />
              <path d="M 50 140 Q 110 50 240 50 L 240 78 Q 130 78 78 160 Z" fill="url(#water-pattern)" />
              <path d="M 40 145 Q 105 45 240 45" fill="none" stroke="#1E3A8A" stroke-width="1.8" stroke-dasharray="6 4" opacity="0.6" />
              <path d="M 65 130 Q 120 55 240 55" fill="none" stroke="#1E3A8A" stroke-width="1.2" stroke-dasharray="4 4" opacity="0.4" />
              <text x="140" y="32" class="map-water-label">Rivier De Leie ↗</text>

              <!-- Canal De Lieve (Top Water Area) -->
              <rect x="250" y="28" width="600" height="46" fill="#E2EAF8" opacity="0.9" />
              <rect x="250" y="28" width="600" height="46" fill="url(#water-pattern)" />
              <line x1="250" y1="28" x2="850" y2="28" stroke="#1E3A8A" stroke-width="1.8" stroke-dasharray="6 4" opacity="0.6" />
              <line x1="250" y1="42" x2="850" y2="42" stroke="#1E3A8A" stroke-width="1.2" stroke-dasharray="4 4" opacity="0.35" />
              <text x="550" y="22" class="map-water-label text-center" text-anchor="middle">Kanaal De Lieve ➔</text>

              <!-- ============================================== -->
              <!-- VENUE OUTER WALLS (Historical Contour of Vismijn) -->
              <!-- ============================================== -->
              <path d="M 70 435 
                       L 70 345 L 110 345 L 110 195 
                       L 110 160 Q 120 78 240 78 
                       L 850 78 L 850 215 
                       L 905 215 L 905 425 L 830 425 
                       L 830 465 L 745 465 L 745 425 
                       L 425 425 L 425 465 L 155 465 
                       L 155 435 Z" 
                    fill="#F7F3EB" stroke="var(--text-charcoal)" stroke-width="2.5" stroke-linejoin="round" class="venue-outline" />

              <!-- ============================================== -->
              <!-- HISTORIC INTERIOR ROOM ZONES -->
              <!-- ============================================== -->
              <!-- 1. De Leie (Curved Gallery, Top-Left) -->
              <path d="M 110 170 Q 120 80 240 80 L 240 195 L 110 195 Z" fill="#F0EAE1" stroke="#D3C9B8" stroke-width="1.2" stroke-dasharray="4 4" />

              <!-- 2. Brasserie (Middle-Left) -->
              <rect x="110" y="195" width="145" height="145" fill="#EBE4D6" stroke="#D3C9B8" stroke-width="1.2" stroke-dasharray="4 4" />

              <!-- 3. Passage & Festival Bar Area -->
              <rect x="255" y="195" width="85" height="85" fill="#F5EFE6" stroke="#D3C9B8" stroke-width="1.2" stroke-dasharray="4 4" />

              <!-- 4. De Lieve (Top Horizontal Canal Gallery) -->
              <rect x="240" y="80" width="610" height="115" fill="#F2ECE3" stroke="#D3C9B8" stroke-width="1.2" stroke-dasharray="4 4" />
              <line x1="365" y1="80" x2="365" y2="195" stroke="#D3C9B8" stroke-width="1" stroke-dasharray="3 3" opacity="0.7" />
              <line x1="440" y1="80" x2="440" y2="195" stroke="#D3C9B8" stroke-width="1" stroke-dasharray="3 3" opacity="0.7" />
              <line x1="525" y1="80" x2="525" y2="195" stroke="#D3C9B8" stroke-width="1" stroke-dasharray="3 3" opacity="0.7" />
              <line x1="695" y1="80" x2="695" y2="195" stroke="#D3C9B8" stroke-width="1" stroke-dasharray="3 3" opacity="0.7" />

              <!-- 5. De Markt (Grand Central Hall) -->
              <rect x="340" y="195" width="490" height="145" fill="#FAF6EE" stroke="#D3C9B8" stroke-width="1.2" stroke-dasharray="4 4" />
              <rect x="425" y="340" width="405" height="85" fill="#FAF6EE" stroke="#D3C9B8" stroke-width="1.2" stroke-dasharray="4 4" />
              <text x="735" y="380" class="map-zone-label">De Markt</text>

              <!-- 6. Balkon (South-East Terrace) -->
              <rect x="830" y="215" width="75" height="210" fill="#E8DFCE" stroke="#D3C9B8" stroke-width="1.2" stroke-dasharray="4 4" />
              <text x="868" y="325" class="map-zone-label vertical-text">Balkon</text>

              <!-- 7. Poortgebouw (West Entrance Gatehouse) -->
              <rect x="70" y="345" width="85" height="90" fill="#EAE2D4" stroke="#D3C9B8" stroke-width="1.2" stroke-dasharray="4 4" />

              <!-- 8. Binnenkoer (Spacious Central Courtyard) -->
              <rect x="155" y="340" width="270" height="125" fill="#F4EEE4" stroke="#D3C9B8" stroke-width="1.2" stroke-dasharray="4 4" />
              <rect x="155" y="340" width="270" height="125" fill="url(#cobble-pattern)" pointer-events="none" opacity="0.4" />

              <!-- ============================================== -->
              <!-- HISTORIC STONE PILLARS (Colonnade in Aisles) -->
              <!-- ============================================== -->
              <g class="pillars">
                <circle cx="450" cy="204" r="5" class="pillar" />
                <circle cx="575" cy="204" r="5" class="pillar" />
                <circle cx="635" cy="204" r="5" class="pillar" />
                <circle cx="700" cy="204" r="5" class="pillar" />
                <circle cx="770" cy="204" r="5" class="pillar" />

                <circle cx="450" cy="335" r="5" class="pillar" />
                <circle cx="510" cy="335" r="5" class="pillar" />
                <circle cx="570" cy="335" r="5" class="pillar" />
                <circle cx="630" cy="335" r="5" class="pillar" />
                <circle cx="700" cy="335" r="5" class="pillar" />
                <circle cx="770" cy="335" r="5" class="pillar" />

                <circle cx="510" cy="415" r="5" class="pillar" />
                <circle cx="570" cy="415" r="4.5" class="pillar" />
                <circle cx="630" cy="415" r="4.5" class="pillar" />
                <circle cx="700" cy="415" r="4.5" class="pillar" />
                <circle cx="770" cy="415" r="4.5" class="pillar" />
              </g>

              <!-- ============================================== -->
              <!-- STREET LABELS & ANNOTATIONS (Clean Margins) -->
              <!-- ============================================== -->
              <g class="map-annotation-zone">
                <text x="10" y="335" font-family="var(--font-sans)" font-size="12" font-weight="800" fill="var(--text-charcoal)">Sint-Veerleplein ➔</text>
                <text x="930" y="320" font-family="var(--font-sans)" font-size="12" font-weight="800" fill="var(--text-charcoal)" class="vertical-text">Rekelingestraat ➔</text>
              </g>

              <!-- ============================================== -->
              <!-- ENTRANCE & FACILITIES -->
              <!-- ============================================== -->
              <!-- Inkom & Vestiaire Block (Horizontal readable layout) -->
              <g class="svg-facility">
                <rect x="295" y="348" width="120" height="110" rx="4" class="stand-box organisation" />
                <circle cx="355" cy="375" r="12" fill="#1E3A8A" />
                <path d="M 355 369 L 355 381 M 350 374 L 355 369 L 360 374" stroke="#FFFFFF" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" fill="none" />
                <text x="355" y="406" class="facility-title" style="font-size: 11px; letter-spacing: 0.08em;">INKOM</text>
                <text x="355" y="423" class="facility-title" style="font-size: 9.5px; fill: #475569; font-weight: 700;">&amp; VESTIAIRE</text>
                <text x="355" y="443" class="facility-sub" style="font-size: 8px; fill: #1E3A8A; font-weight: 800; letter-spacing: 0.05em;">➔ ENTREE</text>
              </g>

              <!-- Foodtrucks (Binnenkoer) -->
              <g class="svg-stand" data-stand="F1" title="Foodtruck Meat the grill">
                <rect x="175" y="350" width="86" height="34" rx="3" class="stand-box catering" />
                <text x="218" y="364" class="stand-num catering-text text-bold">Foodtruck F1</text>
                <text x="218" y="377" class="stand-sub catering-text">Meat the Grill</text>
              </g>

              <g class="svg-stand" data-stand="F2" title="Foodtruck Mixed Worlds">
                <rect x="152" y="392" width="86" height="34" rx="3" class="stand-box catering" />
                <text x="195" y="406" class="stand-num catering-text text-bold">Foodtruck F2</text>
                <text x="195" y="419" class="stand-sub catering-text">Mixed Worlds</text>
              </g>

              <!-- ============================================== -->
              <!-- BRASSERIE STANDS (Links) & BAR & MASTERCLASSES -->
              <!-- ============================================== -->
              <g class="svg-stand" data-stand="37">
                <rect x="115" y="208" width="38" height="28" rx="3" class="stand-box" />
                <text x="134" y="226" class="stand-num">37</text>
              </g>
              <g class="svg-stand" data-stand="36">
                <rect x="115" y="244" width="38" height="28" rx="3" class="stand-box" />
                <text x="134" y="262" class="stand-num">36</text>
              </g>
              <g class="svg-stand" data-stand="35">
                <rect x="115" y="280" width="38" height="28" rx="3" class="stand-box" />
                <text x="134" y="298" class="stand-num">35</text>
              </g>

              <!-- Festival Bar (Drinks & Food) -->
              <g class="svg-stand" data-stand="BAR" title="Festival Bar (Food and drinks)">
                <rect x="188" y="206" width="94" height="38" rx="3" class="stand-box bar-box" />
                <text x="235" y="222" class="stand-num organisation-text text-bold">BAR</text>
                <text x="235" y="236" class="stand-sub organisation-text">Drinks &amp; Food</text>
              </g>

              <!-- Hier melden voor Masterclasses -->
              <g class="svg-stand" data-stand="MC" title="Hier melden voor Masterclasses">
                <rect x="188" y="252" width="94" height="38" rx="3" class="stand-box mc-box" />
                <text x="235" y="267" class="stand-sub" style="font-weight: 800;">Hier melden voor</text>
                <text x="235" y="280" class="stand-num organisation-text text-bold">Masterclasses</text>
              </g>

              <!-- ============================================== -->
              <!-- DE LEIE (Curved Gallery, Top-Left) -->
              <!-- ============================================== -->
              <g class="svg-stand" data-stand="2">
                <rect x="220" y="95" width="38" height="28" rx="3" class="stand-box" />
                <text x="239" y="113" class="stand-num">2</text>
              </g>
              <g class="svg-stand" data-stand="3">
                <rect x="275" y="95" width="38" height="28" rx="3" class="stand-box" />
                <text x="294" y="113" class="stand-num">3</text>
              </g>

              <g class="svg-stand" data-stand="1">
                <rect x="165" y="110" width="36" height="28" rx="3" class="stand-box" />
                <text x="183" y="128" class="stand-num">1</text>
              </g>
              <g class="svg-stand" data-stand="4">
                <rect x="165" y="145" width="36" height="28" rx="3" class="stand-box" />
                <text x="183" y="163" class="stand-num">4</text>
              </g>
              <g class="svg-stand" data-stand="5">
                <rect x="220" y="145" width="38" height="28" rx="3" class="stand-box" />
                <text x="239" y="163" class="stand-num">5</text>
              </g>
              <g class="svg-stand" data-stand="6">
                <rect x="275" y="145" width="38" height="28" rx="3" class="stand-box" />
                <text x="294" y="163" class="stand-num">6</text>
              </g>

              <!-- ============================================== -->
              <!-- DE LIEVE (Top Canal Gallery) -->
              <!-- ============================================== -->
              <g class="svg-stand" data-stand="11">
                <rect x="405" y="100" width="55" height="28" rx="3" class="stand-box" />
                <text x="432" y="118" class="stand-num">11</text>
              </g>
              <g class="svg-stand" data-stand="12">
                <rect x="488" y="100" width="50" height="28" rx="3" class="stand-box" />
                <text x="513" y="118" class="stand-num">12</text>
              </g>

              <g class="svg-stand" data-stand="9">
                <rect x="405" y="140" width="36" height="28" rx="3" class="stand-box" />
                <text x="423" y="158" class="stand-num">9</text>
              </g>
              <g class="svg-stand" data-stand="10">
                <rect x="448" y="140" width="36" height="28" rx="3" class="stand-box" />
                <text x="466" y="158" class="stand-num">10</text>
              </g>
              <g class="svg-stand" data-stand="15">
                <rect x="492" y="140" width="38" height="28" rx="3" class="stand-box" />
                <text x="511" y="158" class="stand-num">15</text>
              </g>

              <g class="svg-stand" data-stand="13">
                <rect x="565" y="102" width="90" height="35" rx="3" class="stand-box" />
                <text x="610" y="124" class="stand-num">13</text>
              </g>
              <g class="svg-stand" data-stand="14">
                <rect x="565" y="145" width="90" height="35" rx="3" class="stand-box" />
                <text x="610" y="167" class="stand-num">14</text>
              </g>

              <!-- ============================================== -->
              <!-- DE MARKT (Central Main Hall) -->
              <!-- ============================================== -->
              <g class="svg-stand" data-stand="O" title="Organisatie & Infodesk">
                <rect x="320" y="206" width="36" height="114" rx="3" class="stand-box organisation" />
                <circle cx="338" cy="222" r="7" fill="#1E3A8A" />
                <text x="338" y="225" font-family="var(--font-sans)" font-size="9" font-weight="900" fill="#FFFFFF" text-anchor="middle">i</text>
                <text x="338" y="272" class="stand-num text-bold vertical-text" style="font-size: 8.5px; fill: #1E3A8A; letter-spacing: 0.12em;">ORGANISATIE</text>
              </g>

              <g class="svg-stand" data-stand="21">
                <rect x="375" y="210" width="42" height="28" rx="3" class="stand-box" />
                <text x="396" y="228" class="stand-num">21</text>
              </g>
              <g class="svg-stand" data-stand="20">
                <rect x="445" y="210" width="140" height="28" rx="3" class="stand-box" />
                <text x="515" y="228" class="stand-num">20</text>
              </g>
              <g class="svg-stand" data-stand="18">
                <rect x="612" y="210" width="58" height="28" rx="3" class="stand-box" />
                <text x="641" y="228" class="stand-num">18</text>
              </g>

              <g class="svg-stand" data-stand="29">
                <rect x="430" y="255" width="58" height="22" rx="2" class="stand-box" />
                <text x="459" y="271" class="stand-num">29</text>
              </g>
              <g class="svg-stand" data-stand="31">
                <rect x="542" y="255" width="60" height="22" rx="2" class="stand-box" />
                <text x="572" y="271" class="stand-num">31</text>
              </g>

              <g class="svg-stand" data-stand="28">
                <rect x="430" y="280" width="58" height="22" rx="2" class="stand-box" />
                <text x="459" y="296" class="stand-num">28</text>
              </g>
              <g class="svg-stand" data-stand="30">
                <rect x="542" y="280" width="60" height="22" rx="2" class="stand-box" />
                <text x="572" y="296" class="stand-num">30</text>
              </g>

              <g class="svg-stand" data-stand="23">
                <rect x="452" y="325" width="40" height="28" rx="3" class="stand-box" />
                <text x="472" y="343" class="stand-num">23</text>
              </g>
              <g class="svg-stand" data-stand="24">
                <rect x="498" y="325" width="40" height="28" rx="3" class="stand-box" />
                <text x="518" y="343" class="stand-num">24</text>
              </g>
              <g class="svg-stand" data-stand="25">
                <rect x="552" y="325" width="118" height="28" rx="3" class="stand-box" />
                <text x="611" y="343" class="stand-num">25</text>
              </g>

              <g class="svg-stand" data-stand="27">
                <rect x="696" y="230" width="40" height="30" rx="3" class="stand-box" />
                <text x="716" y="250" class="stand-num">27</text>
              </g>
              <g class="svg-stand" data-stand="26">
                <rect x="696" y="270" width="40" height="30" rx="3" class="stand-box" />
                <text x="716" y="290" class="stand-num">26</text>
              </g>

            </svg>
          </div>
        </div>
      </div>
      
      <!-- RIGHT COLUMN: Stand Info Card -->
      <div class="sidebar-exhibitors-panel">
        
        <!-- Interactive Detail Card -->
        <div class="sidebar-card info-card-detail" id="stand-info-card">
          <div class="card-padded" id="default-info-state">
            <h3 class="card-inner-title text-center">Stand Detail</h3>
            <div class="vintage-line"></div>
            <p class="sidebar-card-text text-center italic-text">
              Klik op een standnummer op de plattegrond of kies een standhouder uit de lijst om de details, merken en zaallocatie te bekijken.
            </p>
          </div>
          
          <div class="card-padded" id="active-info-state" style="display: none;">
            <div class="detail-stand-badge-row">
              <span class="detail-stand-number" id="detail-number">Stand 1</span>
              <span class="status-badge" id="detail-category-badge">Schots</span>
            </div>
            
            <div class="detail-content-block">
              <h3 class="card-inner-title" id="detail-name">Standhouder Naam</h3>
              <div class="vintage-line" style="margin: 0.5rem 0 1rem 0;"></div>
              
              <div class="detail-hall-row" id="detail-hall-box" style="display: none;">
                <span class="hall-badge">📍 <span id="detail-hall">De Markt</span></span>
              </div>

              <p class="sidebar-card-text" id="detail-description">
                Beschrijving van de standhouder.
              </p>
              
              <div class="detail-brands-box" id="detail-brands-box">
                <span class="brands-label">Aanwezige Merken:</span>
                <div class="brands-list-tags" id="detail-brands">
                  <!-- Dynamic brands go here -->
                </div>
              </div>
            </div>
          </div>
        </div>

      </div>
    </div>

    <!-- FULL DIRECTORY LIST BELOW -->
    <section class="directory-list-section">
      <div class="directory-section-header">
        <h2 class="directory-title">Deelnemerslijst (A-Z)</h2>
        <span class="results-counter" id="results-count">{exhibitors.length} standhouders gevonden</span>
      </div>
      
      <div class="directory-grid" id="directory-grid">
        {exhibitors.map((exh) => (
          <div class="directory-item-card" data-id={exh.id} data-cat={exh.category} data-name={exh.name.toLowerCase()} data-brands={(exh.brands || []).join(' ').toLowerCase()} data-hall={(exh.hall || '').toLowerCase()}>
            <div class="card-top-header">
              <span class="card-stand-number">
                {exh.isNotOnMap ? 'Niet op plattegrond' : 
                 exh.id === 'BAR' ? 'Centrale Bar' : 
                 exh.id === 'O' ? 'Infodesk & Organisatie' : 
                 exh.id.startsWith('F') ? ('Foodtruck ' + exh.id) : 
                 ('Stand ' + exh.id)}
              </span>
              <span class={'category-tag tag-' + exh.category}>
                {exh.category === 'scotch' ? 'Schots' : 
