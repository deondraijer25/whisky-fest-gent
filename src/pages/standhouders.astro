---
// src/pages/standhouders.astro
// Interactieve Plattegrond & Standhouders voor Gents Whisky Festival (De Oude Vismijn Gent)
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getStandhouders } from '../lib/ghl';

const exhibitors = await getStandhouders('gent');
---

<Layout 
  title="Interactieve Plattegrond & Standhouders" 
  description="Navigeer door De Oude Vismijn Gent met onze interactieve festivalplattegrond. Vind direct waar al uw favoriete whiskymerken en standhouders zich bevinden op het Gents Whisky Festival."
>
  <!-- Navigation Header -->
  <Header />

  <main class="standhouders-page-wrapper">
    <!-- Page Header -->
    <div class="page-title-section animate-fade-in">
      <span class="page-tag">Festival Gids 2026</span>
      <h1 class="page-title">Plattegrond & Stands</h1>
      <div class="vintage-line"></div>
      <p class="page-subtitle">Verken de historische zalen van De Oude Vismijn, zoek uw favoriete merken en zie direct welke standhouder zich waar bevindt.</p>
    </div>

    <!-- Horizontal Search & Filters Bar -->
    <div class="search-filter-horizontal-bar vintage-frame animate-fade-in" style="animation-delay: 0.1s;">
      <div class="vintage-frame-inner horizontal-bar-inner">
        
        <div class="search-input-wrapper">
          <input type="text" id="exhibitor-search" class="form-control" placeholder="Zoek op standhouder of merk..." />
          <span class="search-icon-inside">
            <svg class="search-icon-svg" viewBox="0 0 24 24" width="16" height="16" stroke="var(--text-charcoal)" stroke-width="2.5" fill="none" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="11" cy="11" r="8"></circle>
              <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
            </svg>
          </span>
        </div>
        
        <div class="filter-buttons-row">
          <button type="button" class="filter-tab active" data-filter="all">Alle</button>
          <button type="button" class="filter-tab" data-filter="belgian">Belgisch</button>
          <button type="button" class="filter-tab" data-filter="scotch">Schots</button>
          <button type="button" class="filter-tab" data-filter="independent">Onafhankelijk</button>
          <button type="button" class="filter-tab" data-filter="world">Wereld</button>
          <button type="button" class="filter-tab" data-filter="catering">Food &amp; Catering</button>
        </div>

      </div>
    </div>

    <!-- Interactive Map & Detail Layout -->
    <div class="map-detail-layout animate-fade-in" style="animation-delay: 0.15s;">
      
      <!-- LEFT COLUMN: The Digital Vector Floor Plan Map of De Oude Vismijn -->
      <div class="map-visual-container vintage-frame">
        <div class="vintage-frame-inner map-scroll-area">
          <div class="map-toolbar">
            <span class="toolbar-title">Plattegrond De Oude Vismijn Gent</span>
            <div class="zoom-controls">
              <button type="button" class="zoom-btn" id="zoom-in" title="Inzoomen">＋</button>
              <button type="button" class="zoom-btn" id="zoom-out" title="Uitzoomen">－</button>
              <button type="button" class="zoom-btn" id="zoom-reset" title="Herstellen">Herstel</button>
            </div>
          </div>
          
          <div class="svg-zoom-wrapper" id="svg-zoom-target">
            <!-- 100% PURE DIGITAL VECTOR SVG MAP OF DE OUDE VISMIJN GENT (LANDSCAPE EXACT LIKE DEN HAAG) -->
            <svg viewBox="0 0 980 500" class="vismijn-svg-map" id="vismijn-map">
              <defs>
                <pattern id="pillar-pattern" width="10" height="10" patternUnits="userSpaceOnUse">
                  <circle cx="5" cy="5" r="3" fill="var(--border-color)" />
                </pattern>
                
                <pattern id="water-pattern" width="20" height="10" patternUnits="userSpaceOnUse">
                  <path d="M 0 5 Q 5 2 10 5 T 20 5" fill="none" stroke="rgba(30, 58, 138, 0.12)" stroke-width="1.2" />
                </pattern>

                <pattern id="cobble-pattern" width="12" height="12" patternUnits="userSpaceOnUse">
                  <path d="M 0 6 L 6 0 L 12 6 L 6 12 Z" fill="none" stroke="rgba(15, 23, 42, 0.04)" stroke-width="0.8" />
                </pattern>
              </defs>

              <!-- Blueprint grid / transparent canvas -->
              <rect width="980" height="500" fill="transparent" />

              <!-- ============================================== -->
              <!-- EXTERIOR WATERWAYS: DE LEIE & DE LIEVE -->
              <!-- ============================================== -->
              <!-- River De Leie (Top-Left Water Area) -->
              <path d="M 50 140 Q 110 50 240 50 L 240 78 Q 130 78 78 160 Z" fill="url(#water-pattern)" />
              <path d="M 60 130 Q 120 40 250 40" fill="none" stroke="var(--primary-color)" stroke-width="1.5" stroke-dasharray="6 4" opacity="0.45" />
              <text x="145" y="36" class="map-water-label">Rivier De Leie ↗</text>

              <!-- Canal De Lieve (Top Water Area) -->
              <rect x="250" y="32" width="600" height="42" fill="url(#water-pattern)" />
              <line x1="250" y1="32" x2="850" y2="32" stroke="var(--primary-color)" stroke-width="1.5" stroke-dasharray="6 4" opacity="0.45" />
              <text x="550" y="26" class="map-water-label text-center" text-anchor="middle">Kanaal De Lieve ➔</text>

              <!-- ============================================== -->
              <!-- VENUE OUTER WALLS (Historical Contour of Vismijn) -->
              <!-- ============================================== -->
              <path d="M 70 435 
                       L 70 345 L 110 345 L 110 195 
                       L 110 160 Q 120 78 240 78 
                       L 850 78 L 850 215 
                       L 905 215 L 905 425 L 830 425 
                       L 830 465 L 745 465 L 745 425 
                       L 425 425 L 425 465 L 155 465 
                       L 155 435 Z" 
                    fill="var(--bg-sand)" stroke="var(--text-charcoal)" stroke-width="2.5" stroke-linejoin="round" class="venue-outline" />

              <!-- ============================================== -->
              <!-- HISTORIC INTERIOR ROOM ZONES -->
              <!-- ============================================== -->

              <!-- 1. De Leie (Curved Gallery, Top-Left) -->
              <path d="M 110 170 Q 120 80 240 80 L 240 195 L 110 195 Z" fill="#F6F1E7" stroke="var(--border-color)" stroke-width="1.5" stroke-dasharray="4 4" />
              <text x="210" y="165" class="map-zone-label" text-anchor="middle">De Leie</text>

              <!-- 2. Brasserie (Middle-Left) -->
              <rect x="110" y="195" width="145" height="145" fill="#EFE8DC" stroke="var(--border-color)" stroke-width="1.5" stroke-dasharray="4 4" />
              <text x="145" y="322" class="map-zone-label">Brasserie</text>

              <!-- 3. Passage & Festival Bar Area -->
              <rect x="255" y="195" width="85" height="85" fill="#E9E2D4" stroke="var(--border-color)" stroke-width="1.2" />

              <!-- 4. De Lieve (Top Horizontal Canal Gallery) -->
              <rect x="240" y="80" width="610" height="115" fill="#EFE8DC" stroke="var(--border-color)" stroke-width="1.5" stroke-dasharray="4 4" />
              <text x="545" y="102" class="map-zone-label">De Lieve</text>
              
              <!-- Bay dividers in De Lieve -->
              <line x1="365" y1="80" x2="365" y2="195" stroke="var(--border-color)" stroke-width="1" stroke-dasharray="3 3" />
              <line x1="440" y1="80" x2="440" y2="195" stroke="var(--border-color)" stroke-width="1" stroke-dasharray="3 3" />
              <line x1="525" y1="80" x2="525" y2="195" stroke="var(--border-color)" stroke-width="1" stroke-dasharray="3 3" />
              <line x1="695" y1="80" x2="695" y2="195" stroke="var(--border-color)" stroke-width="1" stroke-dasharray="3 3" />

              <!-- 5. De Markt (Grand Central Hall, L-Shape avoiding Binnenkoer) -->
              <rect x="340" y="195" width="490" height="145" fill="#FAF7F0" stroke="var(--border-color-dark)" stroke-width="1.8" />
              <rect x="425" y="340" width="405" height="85" fill="#FAF7F0" stroke="var(--border-color-dark)" stroke-width="1.8" />
              <text x="610" y="275" class="map-zone-label big-zone-label" text-anchor="middle">De Markt</text>

              <!-- 6. Balkon (South-East Terrace overlooking Rekelingestraat) -->
              <rect x="830" y="215" width="75" height="210" fill="#E8E0D0" stroke="var(--text-charcoal)" stroke-width="2" />
              <text x="868" y="320" class="map-zone-label vertical-text">Balkon</text>

              <!-- 7. Poortgebouw (West Entrance Gatehouse) -->
              <rect x="70" y="345" width="85" height="90" fill="#EAE2D2" stroke="var(--text-charcoal)" stroke-width="2" />
              <text x="112" y="422" class="map-zone-label small-label" text-anchor="middle">Poortgebouw</text>

              <!-- 8. Binnenkoer (Spacious Central Courtyard) -->
              <rect x="155" y="340" width="270" height="125" fill="#F8F5EE" stroke="var(--border-color)" stroke-width="1.5" />
              <rect x="155" y="340" width="270" height="125" fill="url(#cobble-pattern)" pointer-events="none" />
              <text x="290" y="452" class="map-zone-label" text-anchor="middle">Binnenkoer</text>

              <!-- ============================================== -->
              <!-- HISTORIC STONE PILLARS (Colonnade in Aisles) -->
              <!-- ============================================== -->
              <g class="pillars">
                <!-- Colonnade Top Row (y=204 in open walking aisle) -->
                <circle cx="450" cy="204" r="6" class="pillar" />
                <circle cx="575" cy="204" r="6" class="pillar" />
                <circle cx="635" cy="204" r="6" class="pillar" />
                <circle cx="700" cy="204" r="6" class="pillar" />
                <circle cx="770" cy="204" r="6" class="pillar" />

                <!-- Colonnade Middle Row (y=335 in open walking aisle) -->
                <circle cx="450" cy="335" r="6" class="pillar" />
                <circle cx="510" cy="335" r="6" class="pillar" />
                <circle cx="570" cy="335" r="6" class="pillar" />
                <circle cx="630" cy="335" r="6" class="pillar" />
                <circle cx="700" cy="335" r="6" class="pillar" />
                <circle cx="770" cy="335" r="6" class="pillar" />

                <!-- Colonnade Bottom Row (y=415 in open walking aisle) -->
                <circle cx="510" cy="415" r="6" class="pillar" />
                <circle cx="570" cy="415" r="6" class="pillar" />
                <circle cx="630" cy="415" r="6" class="pillar" />
                <circle cx="700" cy="415" r="6" class="pillar" />
                <circle cx="770" cy="415" r="6" class="pillar" />
              </g>

              <!-- ============================================== -->
              <!-- STREET LABELS & ANNOTATIONS (Clean Margins) -->
              <!-- ============================================== -->
              <text x="10" y="335" class="map-street-label">Sint-Veerleplein ➔</text>
              <text x="925" y="320" class="map-street-label vertical-text">Rekelingestraat ➔</text>

              <!-- ============================================== -->
              <!-- ENTRANCE FLOW: SINT-VEERLEPLEIN -> INKOM -->
              <!-- ============================================== -->
              <g class="map-entrance-flow">
                <!-- Directional dashed line from margin -->
                <path d="M 15 375 L 70 375" stroke="#FF6500" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" stroke-dasharray="5 3" fill="none" />
                <polygon points="70,375 60,370 60,380" fill="#FF6500" />
                
                <!-- INKOM & VESTIAIRE Badge placed cleanly inside Gatehouse -->
                <rect x="75" y="360" width="76" height="30" rx="3" fill="#FF6500" />
                <text x="113" y="373" font-family="var(--font-sans)" font-size="8.5" font-weight="900" fill="#FFFFFF" text-anchor="middle" letter-spacing="0.08em">INKOM &amp;</text>
                <text x="113" y="384" font-family="var(--font-sans)" font-size="8.5" font-weight="900" fill="#FFFFFF" text-anchor="middle" letter-spacing="0.08em">VESTIAIRE</text>

                <!-- Connection arrow into Binnenkoer -->
                <path d="M 151 375 L 175 375" stroke="#FF6500" stroke-width="2" stroke-dasharray="4 3" fill="none" />
                <polygon points="175,375 167,371 167,379" fill="#FF6500" />
              </g>

              <!-- ============================================== -->
              <!-- BUITENTERREIN: FOODTRUCKS (Binnenkoer) -->
              <!-- ============================================== -->
              <!-- Clean Header Banner for Foodtrucks -->
              <rect x="180" y="352" width="220" height="20" rx="3" fill="rgba(255, 101, 0, 0.1)" stroke="#FF6500" stroke-width="1.2" />
              <text x="290" y="366" font-family="var(--font-sans)" font-size="9" font-weight="900" fill="#FF6500" text-anchor="middle" letter-spacing="0.08em">FOODTRUCKS BUITENTERREIN</text>

              <!-- Foodtruck 1: Meat the grill -->
              <g class="svg-stand" data-stand="F1" title="Meat the grill">
                <rect x="185" y="380" width="100" height="45" rx="3" class="stand-box catering" />
                <text x="235" y="399" class="stand-num text-bold">F1: MEAT</text>
                <text x="235" y="414" class="stand-sub text-nano">Artisan BBQ Burgers</text>
              </g>

              <!-- Foodtruck 2: Mixed Worlds -->
              <g class="svg-stand" data-stand="F2" title="Mixed Worlds">
                <rect x="295" y="380" width="100" height="45" rx="3" class="stand-box catering" />
                <text x="345" y="399" class="stand-num text-bold">F2: WORLDS</text>
                <text x="345" y="414" class="stand-sub text-nano">Streetfood &amp; Tacos</text>
              </g>

              <!-- ============================================== -->
              <!-- FESTIVAL BAR (Food and drinks) -->
              <!-- ============================================== -->
              <g class="svg-stand" data-stand="BAR" title="Festival Bar (Food and drinks)">
                <rect x="265" y="210" width="65" height="46" rx="3" class="stand-box bar-box" />
                <text x="297" y="230" class="stand-num text-bold text-small">BAR</text>
                <text x="297" y="244" class="stand-sub text-nano">Drinks &amp; Food</text>
              </g>

              <!-- ============================================== -->
              <!-- BRASSERIE STANDS & FOOD TASTING TABLES -->
              <!-- ============================================== -->
              <!-- Stand 37 -->
              <g class="svg-stand" data-stand="37">
                <rect x="120" y="208" width="40" height="28" rx="3" class="stand-box" />
                <text x="140" y="226" class="stand-num text-small">37</text>
              </g>
              <!-- Stand 36 -->
              <g class="svg-stand" data-stand="36">
                <rect x="120" y="244" width="40" height="28" rx="3" class="stand-box" />
                <text x="140" y="262" class="stand-num text-small">36</text>
              </g>
              <!-- Stand 35: Beyond Jewels -->
              <g class="svg-stand" data-stand="35">
                <rect x="120" y="280" width="40" height="28" rx="3" class="stand-box" />
                <text x="140" y="298" class="stand-num text-small">35</text>
              </g>

              <!-- Food Tasting Tables (Circular Stations with Clean Label) -->
              <g class="food-tasting-group">
                <circle cx="185" cy="222" r="10" class="tasting-circle" />
                <circle cx="185" cy="258" r="10" class="tasting-circle" />
                <circle cx="185" cy="294" r="10" class="tasting-circle" />
                
                <rect x="202" y="250" width="40" height="17" rx="2" fill="rgba(255, 101, 0, 0.12)" stroke="#FF6500" stroke-width="1" />
                <text x="222" y="262" class="food-banner-text">FOOD</text>
              </g>

              <!-- ============================================== -->
              <!-- DE LEIE STANDS (Curved Gallery, Top-Left) -->
              <!-- ============================================== -->
              <!-- Stand 1: Premium Spirits SRL -->
              <g class="svg-stand" data-stand="1">
                <rect x="130" y="112" width="42" height="30" rx="3" class="stand-box" />
                <text x="151" y="131" class="stand-num">1</text>
              </g>
              <!-- Stand 2: Bacardi Martini Belgium BV -->
              <g class="svg-stand" data-stand="2">
                <rect x="180" y="98" width="42" height="30" rx="3" class="stand-box" />
                <text x="201" y="117" class="stand-num">2</text>
              </g>
              <!-- Stand 25: Cinoco -->
              <g class="svg-stand" data-stand="25">
                <rect x="130" y="150" width="42" height="30" rx="3" class="stand-box" />
                <text x="151" y="169" class="stand-num text-small">25</text>
              </g>
              <!-- Stand 3: TWM Spirits BV -->
              <g class="svg-stand" data-stand="3">
                <rect x="235" y="98" width="42" height="30" rx="3" class="stand-box" />
                <text x="256" y="117" class="stand-num">3</text>
              </g>
              <!-- Stand 5: The Whisky House -->
              <g class="svg-stand" data-stand="5">
                <rect x="180" y="145" width="42" height="30" rx="3" class="stand-box" />
                <text x="201" y="164" class="stand-num">5</text>
              </g>
              <!-- Stand 6: Diageo -->
              <g class="svg-stand" data-stand="6">
                <rect x="235" y="145" width="42" height="30" rx="3" class="stand-box" />
                <text x="256" y="164" class="stand-num">6</text>
              </g>

              <!-- ============================================== -->
              <!-- DE LIEVE STANDS (Top Canal Gallery) -->
              <!-- ============================================== -->
              <!-- Stand 9: La Martiniquaise Benelux -->
              <g class="svg-stand" data-stand="9">
                <rect x="305" y="125" width="45" height="35" rx="3" class="stand-box" />
                <text x="327" y="147" class="stand-num">9</text>
              </g>

              <!-- Stand 10: Brugse Whisky BVBA Transvaal -->
              <g class="svg-stand" data-stand="10">
                <rect x="375" y="105" width="48" height="32" rx="3" class="stand-box" />
                <text x="399" y="125" class="stand-num text-small">10</text>
              </g>
              <!-- Stand 11: Alcobrands -->
              <g class="svg-stand" data-stand="11">
                <rect x="375" y="145" width="48" height="32" rx="3" class="stand-box" />
                <text x="399" y="165" class="stand-num text-small">11</text>
              </g>

              <!-- Stand 15: Chocolatier Vandenbouhede uit Gent -->
              <g class="svg-stand" data-stand="15">
                <rect x="445" y="105" width="48" height="32" rx="3" class="stand-box catering" />
                <text x="469" y="125" class="stand-num text-small">15</text>
              </g>
              <!-- Stand 12: Cley Whisky -->
              <g class="svg-stand" data-stand="12">
                <rect x="445" y="145" width="48" height="32" rx="3" class="stand-box" />
                <text x="469" y="165" class="stand-num text-small">12</text>
              </g>

              <!-- Stand 14: Glengarry Whisky Club (Buffet Counter) -->
              <g class="svg-stand" data-stand="14">
                <rect x="540" y="120" width="55" height="42" rx="3" class="stand-box buffet-stand" />
                <text x="567" y="145" class="stand-num text-small">14</text>
              </g>
              <!-- Stand 13: Glengarry Bar – Verkoop whisky -->
              <g class="svg-stand" data-stand="13">
                <rect x="615" y="120" width="60" height="42" rx="3" class="stand-box" />
                <text x="645" y="145" class="stand-num text-small">13</text>
              </g>

              <!-- ============================================== -->
              <!-- DE MARKT: WEST SECTION (Organisatie, 21, 23, 24, 20) -->
              <!-- ============================================== -->
              <!-- Stand O: Organisatie -->
              <g class="svg-stand" data-stand="O" title="Organisatie">
                <rect x="350" y="210" width="80" height="38" rx="3" class="stand-box organisation" />
                <text x="390" y="228" class="stand-num text-bold text-small">O: ORG</text>
                <text x="390" y="241" class="stand-sub text-nano">Botteling &amp; Info</text>
              </g>

              <!-- Stand 21: DaDa Chapel Distillery Gent -->
              <g class="svg-stand" data-stand="21">
                <rect x="350" y="255" width="38" height="30" rx="3" class="stand-box" />
                <text x="369" y="274" class="stand-num text-small">21</text>
              </g>

              <!-- Stand 24: BV Munros -->
              <g class="svg-stand" data-stand="24">
                <rect x="392" y="255" width="38" height="30" rx="3" class="stand-box" />
                <text x="411" y="274" class="stand-num text-small">24</text>
              </g>

              <!-- Stand 23: Filliers Distillery -->
              <g class="svg-stand" data-stand="23">
                <rect x="350" y="292" width="38" height="30" rx="3" class="stand-box" />
                <text x="369" y="311" class="stand-num text-small">23</text>
              </g>

              <!-- Stand 20: Young Charly -->
              <g class="svg-stand" data-stand="20">
                <rect x="392" y="292" width="38" height="30" rx="3" class="stand-box" />
                <text x="411" y="311" class="stand-num text-small">20</text>
              </g>

              <!-- ============================================== -->
              <!-- DE MARKT: STAND 4 (SMWS / Spirituoos GCV - TRIPLE BOOTH) -->
              <!-- ============================================== -->
              <!-- Surrounding border for triple booth Stand 4 -->
              <rect x="448" y="222" width="118" height="46" rx="4" class="triple-stand-frame" />
              <text x="507" y="217" class="triple-stand-label text-center" text-anchor="middle">SMWS TRIPLE BOOTH</text>

              <!-- Table 4 Left -->
              <g class="svg-stand" data-stand="4" title="Stand 4: SMWS / Spirituoos GCV">
                <rect x="453" y="226" width="34" height="38" rx="2" class="stand-box" />
                <text x="470" y="250" class="stand-num">4</text>
              </g>
              <!-- Table 4 Middle -->
              <g class="svg-stand" data-stand="4" title="Stand 4: SMWS / Spirituoos GCV">
                <rect x="491" y="226" width="34" height="38" rx="2" class="stand-box" />
                <text x="508" y="250" class="stand-num">4</text>
              </g>
              <!-- Table 4 Right -->
              <g class="svg-stand" data-stand="4" title="Stand 4: SMWS / Spirituoos GCV">
                <rect x="529" y="226" width="34" height="38" rx="2" class="stand-box" />
                <text x="546" y="250" class="stand-num">4</text>
              </g>

              <!-- ============================================== -->
              <!-- DE MARKT: CENTRAL ISLANDS & SOUTH SECTION -->
              <!-- ============================================== -->
              <!-- Center Island 1: Stands 28 & 29 -->
              <!-- Stand 28: Brown-Forman -->
              <g class="svg-stand" data-stand="28">
                <rect x="460" y="285" width="48" height="34" rx="3" class="stand-box" />
                <text x="484" y="306" class="stand-num text-small">28</text>
              </g>
              <!-- Stand 29: Disaronno International B.V. -->
              <g class="svg-stand" data-stand="29">
                <rect x="518" y="285" width="48" height="34" rx="3" class="stand-box" />
                <text x="542" y="306" class="stand-num text-small">29</text>
              </g>

              <!-- Center Island 2: Stands 30 & 31 -->
              <!-- Stand 30: Distilleerderij de Bronckhorst -->
              <g class="svg-stand" data-stand="30">
                <rect x="590" y="226" width="48" height="35" rx="3" class="stand-box" />
                <text x="614" y="248" class="stand-num text-small">30</text>
              </g>
              <!-- Stand 31: De Cort Distillery -->
              <g class="svg-stand" data-stand="31">
                <rect x="648" y="226" width="48" height="35" rx="3" class="stand-box" />
                <text x="672" y="248" class="stand-num text-small">31</text>
              </g>

              <!-- Stand 18: Waterloo Beers & Spirits -->
              <g class="svg-stand" data-stand="18">
                <rect x="590" y="285" width="55" height="34" rx="3" class="stand-box" />
                <text x="617" y="306" class="stand-num text-small">18</text>
              </g>

              <!-- East section near Balkon: Stands 26 & 27 -->
              <!-- Stand 26: Old whisky Collection! -->
              <g class="svg-stand" data-stand="26">
                <rect x="715" y="226" width="55" height="35" rx="3" class="stand-box" />
                <text x="742" y="248" class="stand-num">26</text>
              </g>

              <!-- Stand 27: Bruichladdich -->
              <g class="svg-stand" data-stand="27">
