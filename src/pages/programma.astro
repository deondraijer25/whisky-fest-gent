            {GENT_SPECIALS_ROWS.map((item) => {
              const live = liveTickets.find(t => t.id === item.id);
              const isSoldOut = Boolean(live?.isSoldOut || (live?.capacity && live?.sold >= live?.capacity) || item.id.includes('bootje') || item.id.includes('tour'));
              const price = live ? live.price : item.price;
              const spk = formatSpeaker(item.host);
              return (
                <article class="agenda-row-item">
                  <div class="col-time">
                    <span class="item-time-val">{item.time}</span>
                    {item.dayLabel && <span class="item-day-sub">{item.dayLabel}</span>}
