    }
    .stmb-header {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.4rem;
    }
  }
</style>

<script>
  // 1. Session Tab Switching (All 7 Cards)
  const navTabs = document.querySelectorAll<HTMLElement>('.session-btn-card');
  const panes = document.querySelectorAll<HTMLElement>('.session-agenda-pane');

  function switchTab(targetId: string, shouldScroll = false) {
    if (!targetId) return;
    const cleanId = targetId.replace('pane-', '').toLowerCase();
    const targetTab = Array.from(navTabs).find(t => t.getAttribute('data-target-tab')?.toLowerCase() === cleanId);
    if (!targetTab) return;

    navTabs.forEach(t => t.classList.remove('active'));
    targetTab.classList.add('active');

    panes.forEach(p => {
      if (p.id === `pane-${cleanId}`) {
        p.classList.add('active');
        if (shouldScroll) {
          setTimeout(() => {
            const yOffset = -90;
            const y = p.getBoundingClientRect().top + window.pageYOffset + yOffset;
            window.scrollTo({ top: y, behavior: 'smooth' });
          }, 150);
        }
      } else {
        p.classList.remove('active');
      }
    });
  }

  navTabs.forEach(tab => {
    tab.addEventListener('click', () => {
      const targetId = tab.getAttribute('data-target-tab');
      if (targetId) switchTab(targetId, false);
    });
  });

  // Handle URL query parameters and hash on load (e.g. ?view=gidsen or #pane-gidsen)
  function handleUrlTarget(shouldScroll = true) {
    const urlParams = new URLSearchParams(window.location.search);
    const viewParam = urlParams.get('view') || urlParams.get('tab');
    const hashParam = window.location.hash.replace('#pane-', '').replace('#', '');
    const target = viewParam || hashParam;
    if (target) {
      switchTab(target, shouldScroll);
    }
  }

  // Run on initial load
  handleUrlTarget(true);

  // Run on hash changes or popstate navigation
  window.addEventListener('hashchange', () => handleUrlTarget(true));
  window.addEventListener('popstate', () => handleUrlTarget(false));


  // 2. Trail Inner Matrix Session Switcher
  const trailTabs = document.querySelectorAll('.trail-inner-btn');
  const trailPanes = document.querySelectorAll('.trail-matrix-subpane');

  trailTabs.forEach(tab => {
    tab.addEventListener('click', () => {
      trailTabs.forEach(t => t.classList.remove('active'));
      tab.classList.add('active');

      const targetId = tab.getAttribute('data-target-trail-matrix');
      trailPanes.forEach(p => {
        if (p.id === `tmatrix-${targetId}`) {
          p.classList.add('active');
        } else {
          p.classList.remove('active');
        }
      });
    });
  });

  // 3. Toast Helper
  function showToast(message: string) {
    const toast = document.getElementById('spacious-toast');
    if (!toast) return;
    toast.innerHTML = `<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#F8E3B6" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg> <span>${message}</span>`;
    toast.style.display = 'flex';
    toast.style.opacity = '1';
    toast.style.transform = 'translateY(0)';
    setTimeout(() => {
      toast.style.opacity = '0';
      toast.style.transform = 'translateY(20px)';
      setTimeout(() => { toast.style.display = 'none'; }, 300);
    }, 3200);
  }

  // 4. Add to Cart (Standard Items)
  document.addEventListener('click', (e) => {
    const btn = (e.target as HTMLElement).closest('.btn-table-buy');
    if (!btn) return;

    e.preventDefault();
    const ticketId = btn.getAttribute('data-ticket-id') || '';
    const title = btn.getAttribute('data-title') || 'Ticket';

    try {
      const stored = localStorage.getItem('whiskyfest_cart');
      const cart = stored ? JSON.parse(stored) : {};
      cart[ticketId] = (cart[ticketId] || 0) + 1;
      localStorage.setItem('whiskyfest_cart', JSON.stringify(cart));
      window.dispatchEvent(new Event('storage'));
      showToast(`Toegevoegd aan winkelwagen: ${title}`);
    } catch (err) {
      showToast(`Toegevoegd: ${title}`);
    }
  });

  // 5. Book Matrix Slot (Trail Schedule)
  document.addEventListener('click', (e) => {
    const btn = (e.target as HTMLElement).closest('.btn-matrix-action');
    if (!btn) return;

    e.preventDefault();
    const ticketId = btn.getAttribute('data-ticket-id') || '';
    const title = btn.getAttribute('data-title') || 'Whisky Trail';

    try {
      const stored = localStorage.getItem('whiskyfest_cart');
      const cart = stored ? JSON.parse(stored) : {};
      cart[ticketId] = (cart[ticketId] || 0) + 1;
      localStorage.setItem('whiskyfest_cart', JSON.stringify(cart));
      window.dispatchEvent(new Event('storage'));
      showToast(`Toegevoegd aan winkelwagen: ${title}`);
    } catch (err) {
      showToast(`Toegevoegd: ${title}`);
    }
  });

  // 6. Modal
  const modal = document.getElementById('spacious-modal');
  const modalClose = document.getElementById('modal-close-trigger');

  document.addEventListener('click', (e) => {
    const btn = (e.target as HTMLElement).closest('.btn-trigger-details');
    if (!btn) return;

    e.preventDefault();
    const title = btn.getAttribute('data-title') || '';
    const loc = btn.getAttribute('data-loc') || 'Nutshuis';
    const time = btn.getAttribute('data-time') || '';
    const host = btn.getAttribute('data-host') || '';
    const desc = btn.getAttribute('data-desc') || '';
    const price = btn.getAttribute('data-price') || '';

    const titleEl = document.getElementById('m-title');
    const locEl = document.getElementById('m-loc');
    const timeEl = document.getElementById('m-time');
    const descEl = document.getElementById('m-desc');
    const hostEl = document.getElementById('m-host');
    const priceEl = document.getElementById('m-price');

    if (titleEl) titleEl.textContent = title;
    if (locEl) locEl.textContent = loc;
    if (timeEl) timeEl.textContent = `${time} uur`;
    if (descEl) descEl.textContent = desc;
    if (hostEl) hostEl.textContent = host ? `Spreker: ${host}` : 'Officiële Masterclass';
    if (priceEl) priceEl.textContent = price;

    if (modal) {
      modal.style.display = 'flex';
      document.body.style.overflow = 'hidden';
    }
  });

  if (modalClose) {
    modalClose.addEventListener('click', () => {
      if (modal) modal.style.display = 'none';
      document.body.style.overflow = '';
    });
  }
  if (modal) {
    modal.addEventListener('click', (e) => {
      if (e.target === modal) {
        modal.style.display = 'none';
        document.body.style.overflow = '';
      }
    });
  }

  // Buy from Modal
  const mBuy = document.getElementById('m-buy');
  if (mBuy) {
    mBuy.addEventListener('click', () => {
      const titleEl = document.getElementById('m-title');
      showToast(`Toegevoegd aan winkelwagen: ${titleEl?.textContent || 'Ticket'}`);
      if (modal) modal.style.display = 'none';
      document.body.style.overflow = '';
    });
  }
</script>
