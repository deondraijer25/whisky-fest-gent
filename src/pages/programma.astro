    }
    .session-selector-strip {
      grid-template-columns: repeat(2, 1fr);
      gap: 0.5rem;
      margin-top: -1.75rem;
    }
    .agenda-parchment-container {
      padding: 2rem 1.25rem 4rem;
    }
    .pane-header-bar {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.35rem;
    }
    .agenda-row-item {
      grid-template-columns: 1fr;
      gap: 0.65rem;
      padding: 1.25rem 0;
    }
    .col-action {
      flex-direction: row;
      justify-content: space-between;
      align-items: center;
      padding-top: 0.5rem;
      border-top: 1px dashed rgba(140, 110, 70, 0.2);
    }
