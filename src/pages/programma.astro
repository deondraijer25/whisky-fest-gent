function getLiveTicket(id: string) {
  return liveTickets.find(t => t.id === id);
}
---

<Layout 
  title="Programma & Masterclasses - Gents Whisky Festival 2026"
  description="Bekijk het complete festivalprogramma van het Gents Whisky Festival in De Oude Vismijn. Ontdek alle 8 masterclasses, Gentse whisky bootjes en distilleerderij tours."
>
  <Header />

  <main class="program-page">
    <!-- 1. HERO HEADER -->
    <section class="program-hero">
      <div class="program-hero-container">
        <div class="program-hero-badge">
          <span>PROGRAMMA OVERZICHT • 2, 3 &amp; 4 OKTOBER 2026</span>
        </div>
        <h1 class="program-hero-title">
          FESTIVAL PROGRAMMA &amp; SPECIALS
        </h1>
        <p class="program-hero-desc">
          Plan uw ultieme whiskybeleving in De Oude Vismijn te Gent. Ontdek diepgaande masterclasses, historische boottochten over de Gentse grachten en exclusieve distilleerderij bezoeken.
        </p>
      </div>
    </section>

    <!-- 2. SESSION SELECTOR TABS -->
    <section class="program-tabs-section">
      <div class="program-tabs-container">
        <div class="program-nav-tabs" role="tablist" aria-label="Programma Sessies">
          {SESSIONS.map((s, idx) => (
            <button 
              type="button" 
              class={`btn-program-tab ${idx === 0 ? 'active' : ''}`}
              data-target={`pane-${s.id}`}
              role="tab"
              aria-selected={idx === 0 ? 'true' : 'false'}
            >
              <span class="tab-sub">{s.dayLabel}</span>
              <strong class="tab-main">{s.name}</strong>
              <span class="tab-time">{s.timeLabel}</span>
              {s.isSoldOut && <span class="tab-sold-pill">Uitverkocht</span>}
            </button>
          ))}

          <button 
            type="button" 
            class="btn-program-tab tab-special"
            data-target="pane-belevingen"
            role="tab"
            aria-selected="false"
          >
            <span class="tab-sub">BIJZONDERE BELEVING</span>
            <strong class="tab-main">Gentse Specials</strong>
            <span class="tab-time">Bootjes &amp; Dada Chapel</span>
          </button>

          <button 
            type="button" 
            class="btn-program-tab tab-botteling"
            data-target="pane-bottelingen"
            role="tab"
            aria-selected="false"
          >
            <span class="tab-sub">EXCLUSIEF</span>
            <strong class="tab-main">Festival Botteling</strong>
            <span class="tab-time">Dada Chapel Special</span>
          </button>
        </div>
      </div>
    </section>

    <!-- 3. PROGRAM PANES -->
    <section class="program-panes-section">
      <div class="program-panes-container">
        
        <!-- SESSIONS PANES (1 t/m 4) -->
        {SESSIONS.map((s, idx) => (
          <div 
            id={`pane-${s.id}`} 
            class={`program-session-pane ${idx === 0 ? 'active' : ''}`}
            role="tabpanel"
          >
            <!-- Session Banner -->
            <div class="session-info-banner">
              <div class="sib-content">
                <div class="sib-badges">
                  <span class="sib-day-badge">{s.dayLabel}</span>
                  <span class="sib-time-badge">{s.timeLabel}</span>
                  {s.isSoldOut ? (
                    <span class="sib-status-badge sold-out">Sessie Uitverkocht</span>
                  ) : (
                    <span class="sib-status-badge available">Kaarten Beschikbaar</span>
                  )}
                </div>
                <h2 class="sib-title">{s.name} in De Oude Vismijn</h2>
                <p class="sib-desc">
                  Toegang tot de centrale beursvloer met talloze gratis proefdrams, exclusieve stands en onderstaande sessie-activiteiten.
                </p>
              </div>
              <div class="sib-action">
                {s.isSoldOut ? (
                  <button type="button" class="btn btn-outline" disabled>Sessie Volgeboekt</button>
                ) : (
                  <a href="/#sessies" class="btn btn-gold">Boek Entree € 42,50</a>
                )}
              </div>
            </div>

            <!-- Masterclasses & Activities Table -->
            <div class="session-activities-block">
              <h3 class="sab-heading">Activiteiten &amp; Masterclasses tijdens deze sessie</h3>
              
              <div class="activities-cards-grid">
                {s.items.map((item) => {
                  const live = getLiveTicket(item.id);
                  const isSold = live ? live.isSoldOut : (item.id.includes('tour') || item.id.includes('bootje'));
                  const price = live ? live.price : item.price;
                  return (
                    <div class={`activity-card ${isSold ? 'card-sold-out' : ''}`}>
                      <div class="ac-top">
                        <span class="ac-cat-pill">{item.categoryLabel}</span>
                        <span class="ac-time">{item.time}</span>
                      </div>
                      <h4 class="ac-title">{item.title}</h4>
                      <div class="ac-meta">
                        <span class="ac-location">📍 {item.location}</span>
                        <span class="ac-host">🎙️ {item.host}</span>
                      </div>
                      <p class="ac-desc">{item.description}</p>
                      <div class="ac-footer">
                        <div class="ac-price-box">
                          <span class="ac-price-label">Prijs per persoon</span>
                          <strong class="ac-price-val">€ {price.toFixed(2).replace('.', ',')}</strong>
                        </div>
                        {isSold ? (
                          <button type="button" class="btn btn-sold" disabled>Uitverkocht</button>
                        ) : (
                          <button 
                            type="button" 
                            class="btn btn-book-mc"
                            data-ticket-id={item.id}
                            data-title={item.title}
                            data-price={price}
                          >
                            + Reserveer Plek
                          </button>
                        )}
                      </div>
                    </div>
                  );
                })}
              </div>
            </div>
          </div>
        ))}

        <!-- PANE: GENTSE SPECIALS (BOOTJES & DISTILLEERDERIJ TOURS) -->
        <div id="pane-belevingen" class="program-session-pane" role="tabpanel">
          <div class="specials-hero-card">
            <span class="shc-badge">EXCLUSIEF VOOR GENT</span>
            <h2 class="shc-title">Gentse Whisky Bootjes &amp; Distilleerderij Bezoeken</h2>
            <p class="shc-desc">
              Ervaar Gent vanaf het water en neem een uniek kijkje achter de schermen bij de lokale distilleerderij. Deze bijzondere ervaringen zijn een absolute publieksfavoriet.
            </p>
          </div>

          <div class="specials-cards-grid">
            {GENT_SPECIALS.map((sp) => {
              const live = getLiveTicket(sp.id);
              const isSold = live ? live.isSoldOut : sp.isSoldOut;
              const price = live ? live.price : sp.price;
              return (
                <div class="special-feature-card">
                  <div class="sfc-badge-row">
                    <span class="sfc-cat-badge">Gentse Beleving</span>
                    {isSold && <span class="sfc-sold-badge">Volgeboekt</span>}
                  </div>
                  <h3 class="sfc-title">{sp.title}</h3>
                  <div class="sfc-meta-row">
                    <span>🕒 {sp.time}</span>
                    <span>📍 {sp.location}</span>
                  </div>
                  <p class="sfc-desc">{sp.description}</p>
                  
                  <div class="sfc-highlights">
                    <strong>Wat is inbegrepen:</strong>
                    <ul>
                      {sp.highlights.map(h => <li>✓ {h}</li>)}
                    </ul>
                  </div>

                  <div class="sfc-action-row">
                    <div class="sfc-price">
                      <span class="sfc-price-sub">Vast tarief</span>
                      <strong class="sfc-price-num">€ {price.toFixed(2).replace('.', ',')}</strong>
                    </div>
                    {isSold ? (
                      <button type="button" class="btn btn-sold" disabled>Volledig Uitverkocht</button>
                    ) : (
                      <button 
                        type="button" 
                        class="btn btn-book-mc"
                        data-ticket-id={sp.id}
                        data-title={sp.title}
                        data-price={price}
                      >
                        + Boek Beleving
                      </button>
                    )}
                  </div>
                </div>
              );
            })}
          </div>
        </div>

        <!-- PANE: FESTIVAL BOTTELING -->
        <div id="pane-bottelingen" class="program-session-pane" role="tabpanel">
          <div class="botteling-hero-card">
            <div class="bhc-content">
              <span class="bhc-badge">GENTS WHISKY FESTIVAL 2026 • SINGLE CASK</span>
              <h2 class="bhc-title">Dada Chapel Gentse Special</h2>
              <p class="bhc-sub">Limousin Virgin Oak Cask • 7 Jaar Gerijpt • Cask Strength</p>
              <p class="bhc-desc">
                De officiële festivalbotteling van het Gents Whisky Festival 2026. Gestookt door Dada Chapel in hartje Gent en 7 jaar gerijpt op maagdelijk Frans Limousin eikenhout. Een zeldzame verzamel- en proefeditie met een strikt gelimiteerde oplage van 200 genummerde flessen.
              </p>
              
              <div class="bhc-specs-grid">
                <div class="spec-item">
                  <span class="spec-label">Vatsoort</span>
                  <strong class="spec-val">Limousin Virgin Oak</strong>
                </div>
                <div class="spec-item">
                  <span class="spec-label">Leeftijd</span>
                  <strong class="spec-val">7 Jaar</strong>
                </div>
                <div class="spec-item">
                  <span class="spec-label">Oplage</span>
                  <strong class="spec-val">200 Flessen</strong>
                </div>
                <div class="spec-item">
                  <span class="spec-label">Afhalen</span>
                  <strong class="spec-val">Festival Slijterij</strong>
                </div>
              </div>

              <div class="bhc-actions">
                <div class="bhc-price">
                  <span>Prijs per fles (70cl)</span>
                  <strong>€ 95,00</strong>
                </div>
                <button 
                  type="button" 
                  class="btn btn-gold"
                  data-ticket-id="gent-botteling-dada-chapel"
                  data-title="Festival Botteling: Dada Chapel Gentse Special"
                  data-price="95.00"
                >
                  + Bestel Fles voor Afhalen
                </button>
              </div>
            </div>
          </div>
        </div>

      </div>
    </section>
  </main>

  <Footer />
</Layout>

<script>
  // Tab Switching Logic
  document.addEventListener('DOMContentLoaded', () => {
    const tabs = document.querySelectorAll('.btn-program-tab');
    const panes = document.querySelectorAll('.program-session-pane');

    function switchTab(targetId: string) {
      tabs.forEach(t => {
        const isCurrent = t.getAttribute('data-target') === targetId;
        t.classList.toggle('active', isCurrent);
        t.setAttribute('aria-selected', isCurrent ? 'true' : 'false');
      });

      panes.forEach(p => {
        p.classList.toggle('active', p.id === targetId);
      });
    }

    tabs.forEach(tab => {
      tab.addEventListener('click', () => {
        const targetId = tab.getAttribute('data-target');
        if (targetId) {
          switchTab(targetId);
        }
      });
    });

    // Check URL parameters (e.g. ?view=bootjes or ?view=specials)
    const urlParams = new URLSearchParams(window.location.search);
    const view = urlParams.get('view') || window.location.hash.replace('#', '');
    if (view === 'bootjes' || view === 'specials' || view === 'belevingen') {
      switchTab('pane-belevingen');
    } else if (view === 'botteling' || view === 'bottelingen') {
      switchTab('pane-bottelingen');
    }
  });
</script>

<style>
  /* --------------------------------------------------
     GENTS WHISKY FESTIVAL PROGRAMMA STYLING
     Kleuren: Gent Royal Blue (#1E3A8A) & Gent Oranje (#FF6500)
     -------------------------------------------------- */
  .program-page {
    background: #FAF7F2;
    min-height: 100vh;
    padding-bottom: 5rem;
  }

  /* 1. Hero Section */
  .program-hero {
    background: linear-gradient(135deg, #091326 0%, #1E3A8A 35%, #172554 65%, #0B1528 100%);
    color: #FFFFFF;
    padding: 7rem 1.5rem 4rem;
    text-align: center;
    position: relative;
  }

  .program-hero-container {
    max-width: 900px;
    margin: 0 auto;
  }

  .program-hero-badge {
    display: inline-block;
    background: rgba(255, 101, 0, 0.2);
    border: 1px solid #FF6500;
    color: #FF6500;
    font-family: var(--font-sans);
    font-size: 0.8rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    padding: 0.35rem 1rem;
    border-radius: 999px;
    margin-bottom: 1.25rem;
  }

  .program-hero-title {
    font-family: var(--font-display, serif);
    font-size: clamp(2.2rem, 5vw, 3.4rem);
    letter-spacing: 0.04em;
    margin-bottom: 1.25rem;
    line-height: 1.15;
  }

  .program-hero-desc {
    font-family: var(--font-sans);
    font-size: 1.05rem;
    line-height: 1.65;
    color: rgba(255, 255, 255, 0.85);
  }

  /* 2. Tabs Section */
  .program-tabs-section {
    background: #FAF7F2;
    padding: 2rem 1.5rem 0;
    border-bottom: 2px solid rgba(15, 23, 42, 0.08);
  }

  .program-tabs-container {
    max-width: 1280px;
    margin: 0 auto;
  }

  .program-nav-tabs {
    display: flex;
    gap: 0.75rem;
    overflow-x: auto;
    padding-bottom: 1rem;
    scrollbar-width: thin;
  }

  .btn-program-tab {
    flex: 1;
    min-width: 175px;
    background: #FFFFFF;
    border: 2px solid #0F172A;
    box-shadow: 3px 3px 0px #0F172A;
    border-radius: 8px;
    padding: 0.85rem 1rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.2rem;
    cursor: pointer;
    transition: all 0.15s ease;
    text-align: center;
    user-select: none;
  }

  .btn-program-tab:hover {
    transform: translateY(-2px);
    box-shadow: 4px 4px 0px #0F172A;
  }

  .btn-program-tab.active {
    background: #FF6500;
    color: #FFFFFF;
    border-color: #0F172A;
    box-shadow: 4px 4px 0px #0F172A;
  }

  .tab-sub {
    font-family: var(--font-sans);
    font-size: 0.72rem;
    font-weight: 800;
    text-transform: uppercase;
    color: #1E3A8A;
  }

  .btn-program-tab.active .tab-sub {
    color: #FFFFFF;
  }

  .tab-main {
    font-family: var(--font-display, serif);
    font-size: 1.15rem;
    color: #0F172A;
  }

  .btn-program-tab.active .tab-main {
    color: #FFFFFF;
  }

  .tab-time {
    font-family: var(--font-sans);
    font-size: 0.75rem;
    font-weight: 600;
    color: #64748B;
  }

  .btn-program-tab.active .tab-time {
    color: rgba(255, 255, 255, 0.9);
  }

  .tab-sold-pill {
    background: #A81818;
    color: #FFFFFF;
    font-family: var(--font-sans);
    font-size: 0.65rem;
    font-weight: 800;
