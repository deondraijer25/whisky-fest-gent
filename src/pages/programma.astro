function formatSpeaker(host: string) {
  if (!host) return { name: '—', role: '' };
  
  const match = host.match(/^(.*?)\s*\((.*?)\)$/);
  if (match) {
    return { name: match[1].trim(), role: match[2].trim() };
  }
  
  if (host.includes('•')) {
    const parts = host.split('•');
    return { name: parts[0].trim(), role: parts.slice(1).join(' • ').trim() };
  }

  return { name: host, role: '' };
}
---

<Layout 
  title="Programma & Tijdschema 2026 - Gents Whisky Festival" 
  description="Volledig tijdschema van alle masterclasses, boottochten en proeverijen tijdens het Gents Whisky Festival."
>
  <Header />

  <main class="programma-page-main">
    
    <!-- 1. FULL-WIDTH AUTHENTIC FESTIVAL HERO (100% SCHOON & RUSTIG) -->
    <header class="programma-full-hero">
      <div class="hero-photo-layer" aria-hidden="true"></div>
      <div class="hero-tint-overlay" aria-hidden="true"></div>
      
      <div class="hero-barrel-art" aria-hidden="true">
        <img src="/barrels line.svg" alt="" width="360" height="420" loading="eager" />
      </div>

      <div class="hero-content-wrapper animate-fade-in">
        <h1 class="hero-main-title">
          Festival Programma &amp; Tijdschema
        </h1>
        <div class="hero-gold-line"></div>
        <p class="hero-lead-paragraph">
          Stel uw persoonlijke festivalbezoek samen. Bekijk alle masterclasses in De Oude Vismijn, historische boottochten over de Gentse grachten en distilleerderij bezoeken.
        </p>
      </div>
    </header>

    <!-- 2. MAIN CONTAINER ON PARCHMENT BACKGROUND -->
    <div class="agenda-parchment-container">
      
      <!-- 7-CARD SESSION SELECTOR STRIP -->
      <nav class="session-selector-strip" aria-label="Kies een festival sessie of activiteit">
        {SESSIONS.map((s, idx) => (
          <button 
            type="button" 
            class={`session-btn-card ${idx === 0 ? 'active' : ''}`}
            data-target-tab={s.id}
          >
            <span class="btn-card-day">{s.dayLabel}</span>
            <span class="btn-card-name">{s.name}</span>
            <span class="btn-card-time">{s.timeLabel}</span>
          </button>
        ))}
        
        <button 
          type="button" 
          class="session-btn-card"
          data-target-tab="bottelingen"
        >
          <span class="btn-card-day">Exclusief</span>
          <span class="btn-card-name">Festival Bottelingen</span>
          <span class="btn-card-time">Afhalen Slijterij</span>
        </button>

        <button 
          type="button" 
          class="session-btn-card btn-gidsen-special"
          data-target-tab="belevingen"
        >
          <span class="btn-card-day">Gentse Beleving</span>
          <span class="btn-card-name">Bootjes &amp; Tours</span>
          <span class="btn-card-time">Rondvaart &amp; Bezoek</span>
        </button>
      </nav>

      <!-- PANES LIST -->
      <div class="agenda-panes-list">
        
        <!-- 1-5: The 5 Day Sessions -->
        {SESSIONS.map((s, idx) => (
          <section 
            class={`session-agenda-pane ${idx === 0 ? 'active' : ''}`}
            id={`pane-${s.id}`}
          >
            <!-- Pane Header -->
            <div class="pane-header-bar">
              <h2 class="pane-title">{s.name}</h2>
              <span class="pane-badge-time">{s.dayLabel} &bull; {s.timeLabel}</span>
            </div>

            <!-- Masterclasses & Tastings Rows -->
            <div class="pane-rows-list">
              <!-- Column Titles Header -->
              <div class="agenda-table-head">
                <span class="th-cell th-time">Tijd</span>
                <span class="th-cell th-title">Programma</span>
                <span class="th-cell th-type-loc">Type &amp; Locatie</span>
                <span class="th-cell th-speaker">Spreker / Gids</span>
                <span class="th-cell th-action">Prijs &amp; Bestellen</span>
              </div>

              <!-- Rows in 5 Clean Columns -->
              {s.items.map((item) => (
                <article class="agenda-row-item">
                  <!-- 1. Tijd (Begin- en Eindtijd) -->
                  <div class="col-time">
                    <span class="item-time-val">{item.time}</span>
                  </div>

                  <!-- 2. Programma Titel (1 regel) -->
                  <div class="col-title">
                    <h3 class="item-name">{item.title}</h3>
                  </div>

                  <!-- 3. Type & Locatie -->
                  <div class="col-type-loc">
                    <span class={`cat-pill cat-${item.category}`}>{item.categoryLabel}</span>
                    <span class="item-loc-tag">
                      <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path><circle cx="12" cy="10" r="3"></circle></svg>
                      {item.location}
                    </span>
                  </div>

                  <!-- 4. Spreker / Gids (Naam bovenaan, rol/titel eronder) -->
                  <div class="col-speaker">
                    {(() => {
                      const spk = formatSpeaker(item.host);
                      return (
                        <div class="speaker-block">
                          <strong class="speaker-name">{spk.name}</strong>
                          {spk.role && <span class="speaker-role">{spk.role}</span>}
                        </div>
                      );
                    })()}
                  </div>

                  <!-- 5. Prijs & Details / Bestelknop -->
                  <div class="col-action">
                    <strong class="item-price">€ {item.price.toFixed(2).replace('.', ',')}</strong>
                    <div class="action-buttons-group">
                      <button 
                        type="button" 
                        class="btn-trigger-details"
                        data-title={item.title}
                        data-loc={item.location}
                        data-time={item.time}
                        data-host={item.host}
                        data-desc={item.description}
                        data-price={`€ ${item.price.toFixed(2).replace('.', ',')}`}
                      >
                        Details
                      </button>
                      <button 
                        type="button" 
                        class="btn btn-gold btn-table-buy"
                        data-ticket-id={item.id}
                        data-title={item.title}
                      >
                        + Bestel
                      </button>
                    </div>
                  </div>
                </article>
              ))}
            </div>

            </section>
        ))}

        <!-- 6: Bottelingen Pane -->
        <section class="session-agenda-pane" id="pane-bottelingen">
          <div class="pane-header-bar">
            <h2 class="pane-title">Exclusieve Festival Bottelingen 2026</h2>
            <span class="pane-badge-time">Afhalen bij Festivalslijterij (De Oude Vismijn)</span>
          </div>

          <div class="pane-rows-list">
            {BOTTELLINGS.map((b) => (
              <article class="agenda-row-item">
                <!-- Left: Status & Location -->
