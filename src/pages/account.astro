      min-width: 0 !important;
      background-color: var(--bg-sand, #EAF2F8) !important;
      border: 1.5px solid var(--text-charcoal, #0F172A) !important;
      border-bottom: none !important;
      border-radius: 6px 6px 0 0 !important;
      padding: 0.75rem 0.2rem !important;
      font-size: clamp(0.68rem, 2.7vw, 0.8rem) !important;
      font-weight: 800 !important;
      letter-spacing: 0.01em !important;
      text-align: center !important;
      white-space: nowrap !important;
      color: var(--text-charcoal, #0F172A) !important;
      box-sizing: border-box !important;
    }

    .portal-tab-trigger:hover {
      background-color: #DDE8F0 !important;
