  .rules-list {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .rule-item {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .rule-item h5 {
    font-family: var(--font-sans);
    font-weight: 800;
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--text-charcoal);
    margin: 0;
  }

  /* --- Keyframes --- */
  @keyframes fade-in-up {
    from {
      opacity: 0;
      transform: translateY(12px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

