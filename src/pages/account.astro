<script>
  // ====== MY ACCOUNT TABS & DYNAMIC DATA LOADING ======
  document.addEventListener('DOMContentLoaded', () => {
    // toggle-share-menu-handler: Click to toggle share popup
    document.addEventListener('click', (e) => {
      const trigger = e.target.closest('.btn-share-trigger');
      const allMenus = document.querySelectorAll('.ticket-share-menu');
      
      if (trigger) {
        e.stopPropagation();
        const wrapper = trigger.closest('.ticket-share-wrapper');
        const menu = wrapper ? wrapper.querySelector('.ticket-share-menu') : null;
        
        allMenus.forEach(m => {
          if (m !== menu) m.classList.remove('active');
        });
        
        if (menu) {
          menu.classList.toggle('active');
        }
      } else if (!e.target.closest('.ticket-share-menu')) {
        allMenus.forEach(m => m.classList.remove('active'));
      }
    });
    // 1. Tab Swapping Trigger Logic
    const tabTriggers = document.querySelectorAll('.portal-tab-trigger');
    const tabPanes = document.querySelectorAll('.portal-tab-pane');

    tabTriggers.forEach(trigger => {
      trigger.addEventListener('click', () => {
        const targetTab = trigger.getAttribute('data-tab');

        tabTriggers.forEach(t => t.classList.remove('active'));
        trigger.classList.add('active');

        tabPanes.forEach(pane => {
          if (pane.id === targetTab) {
            pane.classList.add('active');
            pane.style.display = "block";
          } else {
            pane.classList.remove('active');
            pane.style.display = "none";
          }
        });
      });
    });

    // 2. Data Population & Synchronization
    const portalWelcomeEmail = document.getElementById('portal-welcome-email');
    const portalTitleName = document.getElementById('portal-title-name');

    // Profile inputs
    const profileInputName = document.getElementById('profile-input-name') as HTMLInputElement;
    const profileInputEmail = document.getElementById('profile-input-email') as HTMLInputElement;
    const profileInputPhone = document.getElementById('profile-input-phone') as HTMLInputElement;
    const profileInputWhisky = document.getElementById('profile-input-whisky') as HTMLSelectElement;
    
    // Receipt elements
    const receiptResNo = document.getElementById('receipt-res-no');
    const receiptResNoMob = document.getElementById('receipt-res-no-mob');
    const receiptTotal = document.getElementById('receipt-total');
    const receiptTotalMob = document.getElementById('receipt-total-mob');

    // Retrieve order details from localStorage
    const stored = localStorage.getItem('wf_last_order');
    let orderData: any = null;
    
    if (stored) {
      try {
        orderData = JSON.parse(stored);
      } catch (e) {
        console.error("Failed to parse stored order:", e);
      }
    }

    // Fallback default order data
    if (!orderData) {
      orderData = {
        name: "Deon Draijer",
        email: "deondraijer@gmail.com",
        items: [
          {
            id: "vip-session",
            title: "VIP Sessie - Vrijdag",
            qty: 1,
            price: 79.50,
            category: "entree"
          }
        ],
        resNumber: "#WF-2026-84387",
        phone: "+31 6 12345678",
        whiskyStyle: "Single Malt Scotch",
        isMember: true,
        totalPrice: 79.50
      };
    }

    if (!orderData.items || orderData.items.length === 0) {
      orderData.items = [
        {
          id: "vip-session",
          title: "VIP Sessie - Vrijdag",
          qty: 1,
          price: 79.50,
          category: "entree"
        }
      ];
    }

    // Dynamic UI Renderer
    function updatePortalUI() {
      const userName = orderData.name || "Deon Draijer";
      const userEmail = orderData.email || "deondraijer@gmail.com";

      if (portalWelcomeEmail) {
        portalWelcomeEmail.textContent = `Welkom in uw bezoeker omgeving · ${userEmail}`;
      }

      if (portalTitleName) {
        if (orderData.isMember) {
          portalTitleName.innerHTML = `Portaal van ${userName} <span class="member-tag-badge">IWS Lid</span>`;
        } else {
          portalTitleName.innerHTML = `Portaal van ${userName}`;
        }
      }

      const resNum = orderData.resNumber || "#WF-2026-84387";
      const formattedTotal = `€ ${(orderData.totalPrice || 79.50).toFixed(2).replace('.', ',')}`;

      if (receiptResNo) receiptResNo.textContent = resNum;
      if (receiptResNoMob) receiptResNoMob.textContent = resNum;
      if (receiptTotal) receiptTotal.textContent = formattedTotal;
      if (receiptTotalMob) receiptTotalMob.textContent = formattedTotal;

      // Populate form inputs
      if (profileInputName) profileInputName.value = userName;
      if (profileInputEmail) profileInputEmail.value = userEmail;
      if (profileInputPhone) profileInputPhone.value = orderData.phone || "+31 6 12345678";
      if (profileInputWhisky) profileInputWhisky.value = orderData.whiskyStyle || "Single Malt Scotch";

      // Render Dynamic Tickets in Tab 1 (Each ticket contains an individual Download Button)
      const ticketsContainer = document.getElementById("tickets-container");
      if (ticketsContainer && orderData.items) {
        ticketsContainer.innerHTML = "";
        
        let globalTicketIndex = 1;
        orderData.items.forEach((item: any) => {
          let displayDay = "13";
          let displayMonth = "OKT";
          let displayTime = item.timeslot || "13:00 - 17:00 UUR";
          let watermark = "WF";
          
          const titleLower = item.title.toLowerCase();
          
          if (item.category === "entree") {
            watermark = orderData.isMember ? "WS" : "WF";
            if (titleLower.includes("vrijdag")) {
              displayDay = "13";
              displayTime = titleLower.includes("vip") ? "13:00 - 17:00 UUR" : "19:00 - 23:00 UUR";
            } else if (titleLower.includes("zondag")) {
              displayDay = "15";
              displayTime = "13:00 - 17:00 UUR";
            } else {
              displayDay = "14";
              displayTime = "13:00 - 17:00 UUR";
            }
          } else if (item.category === "tram") {
            watermark = "WT";
            displayDay = "14";
            displayTime = item.timeslot || "14:00 UUR";
          } else if (item.category === "botteling") {
            watermark = "FB";
            displayDay = "13-15";
            displayTime = item.delivery === "shipping" ? "VERZENDING PER POST" : "AFHALEN (STAND 48)";
          } else if (item.category === "masterclass") {
            watermark = "MC";
            displayDay = "14";
            displayTime = item.timeslot || "14:00 - 14:45 UUR";
          }

          // Expand multiple quantities into individual separate ticket cards
          const qty = item.qty || 1;
          for (let t = 0; t < qty; t++) {
            const rawCode = (orderData.resNumber || "WF-2026-84387").replace('#', '');
            const cleanCode = `${rawCode}-${globalTicketIndex}`;
            const displayCode = `#${cleanCode}`;
            
            // Clean public HTTPS URL that WhatsApp always recognizes as a blue clickable link
            const baseUrl = window.location.origin;
            
            const ticketLink = `${baseUrl}/ticket?id=${cleanCode}&title=${encodeURIComponent(item.title)}&name=${encodeURIComponent(userName)}&time=${encodeURIComponent(displayTime)}`;
            
            const shareText = encodeURIComponent(
              `*${'International Whisky Festival 2026'}*\n` +
              `E-ticket: ${item.title}\n\n` +
              `Kaarthouder: ${userName}\n` +
              `Tijdslot: ${displayTime}\n` +
              `Ticket Code: ${displayCode}\n` +
              `Locatie: De Oude Vismijn, Gent\n\n` +
              `Bekijk en download je officiële E-ticket:\n` +
              `${ticketLink}`
            );
            
            const mailSubject = encodeURIComponent(`E-ticket voor International Whisky Festival: ${item.title}`);
            const mailBody = encodeURIComponent(
              `Beste ${userName},\n\n` +
              `Hierbij ontvang je jouw toegangsbewijs voor International Whisky Festival 2026.\n\n` +
              `Ticket: ${item.title}\n` +
              `Tijdslot: ${displayTime}\n` +
              `Ticket Code: ${displayCode}\n` +
              `Locatie: De Oude Vismijn, Gent\n\n` +
              `Bekijk en download je digitale ticket direct via onderstaande link:\n` +
              `${ticketLink}\n\n` +
              `Graag tot ziens op het festival!`
            );

            // Natural schedule string
            let formattedSchedule = "Vrijdag 13 november 2026 • " + displayTime;
            if (titleLower.includes("zaterdag")) {
              formattedSchedule = "Zaterdag 14 november 2026 • " + displayTime;
            } else if (titleLower.includes("zondag")) {
              formattedSchedule = "Zondag 15 november 2026 • " + displayTime;
            } else if (item.category === 'masterclass') {
              formattedSchedule = "Zaterdag 14 november 2026 • " + displayTime;
            }

            const ticketHTML = `
              <div class="ticket-envelope">
                <div class="ticket-stub-large">
                  <!-- Scanner Stub -->
                  <div class="ticket-right-stub">
                    <span class="scan-label">CONTROLE STUB</span>
                    <div class="qr-code-holder">
                      <svg width="105" height="105" viewBox="0 0 100 100" style="shape-rendering: crispedges; display:block;">
                        <path d="M0,0 h30 v10 h-20 v20 h-10 z" fill="#1D1C1A"/>
                        <path d="M10,10 h10 v10 h-10 z" fill="#1D1C1A"/>
                        <path d="M70,0 h30 v30 h-10 v-20 h-20 z" fill="#1D1C1A"/>
                        <path d="M80,10 h10 v10 h-10 z" fill="#1D1C1A"/>
                        <path d="M0,70 h10 v20 h20 v10 h-30 z" fill="#1D1C1A"/>
                        <path d="M10,80 h10 v10 h-10 z" fill="#1D1C1A"/>
                        <path d="M45,45 h10 v10 h-10 z" fill="var(--whisky-gold-dark)"/>
                        <path d="M30,30 h10 v5 h-10 z M35,40 h15 v5 h-15 z M55,30 h10 v10 h-5 v-5 h-5 z" fill="#1D1C1A"/>
                        <path d="M70,70 h30 v10 h-10 v10 h-20 z M80,80 h10 v10 h-10 z" fill="#1D1C1A"/>
                        <path d="M40,65 h10 v10 h-10 z M55,60 h10 v5 h-10 z M60,75 h5 v15 h-5 z" fill="#1D1C1A"/>
                        <path d="M65,45 h10 v5 h-10 z M30,55 h5 v15 h-5 z M45,85 h10 v5 h-10 z" fill="#1D1C1A"/>
                      </svg>
                    </div>
                    <span class="scan-instructions">${item.category === 'botteling' && item.delivery === 'shipping' ? 'VERZONDEN' : 'SCAN BIJ DE DEUR'}</span>
                    <span class="scan-res-hash">${displayCode}</span>
                  </div>

                  <!-- Clean Main Body -->
                  <div class="ticket-left-stub">
                    <div class="ticket-watermark">${watermark}</div>
                    
                    <!-- 1. Header Row -->
                    <div class="ticket-header-row">
                      <div class="ticket-title-block">
                        <h2 class="ticket-session-title">${item.title}</h2>
                        <p class="ticket-schedule-text">${formattedSchedule}</p>
                      </div>
                      <div class="ticket-badges-block">
                        <span class="ticket-status-tag">
                          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12"></polyline></svg>
                          Geldig Toegangsbewijs
                        </span>
                        ${qty > 1 ? `<span class="ticket-qty-tag">Ticket ${t + 1} van ${qty}</span>` : ''}
                      </div>
                    </div>

                    <!-- 2. Middle Row: 3-Column Meta Grid -->
                    <div class="ticket-meta-trio">
                      <div class="meta-col">
                        <span class="meta-col-label">Kaarthouder</span>
                        <strong class="meta-col-val">${userName}</strong>
                      </div>
                      <div class="meta-col">
                        <span class="meta-col-label">Locatie</span>
                        <strong class="meta-col-val">${item.category === 'masterclass' ? 'De Oude Vismijn (MC-Ruimte)' : 'De Oude Vismijn, Gent'}</strong>
                      </div>
                      <div class="meta-col">
                        <span class="meta-col-label">Ticket Code</span>
                        <strong class="meta-col-val font-mono">${displayCode}</strong>
                      </div>
                    </div>

                    <!-- 3. Bottom Row: Action Buttons -->
                    <div class="ticket-actions-row">
                      <button type="button" class="btn-ticket-download-gold" onclick="window.open('/ticket?id=${cleanCode}&title=${encodeURIComponent(item.title)}&name=${encodeURIComponent(userName)}&time=${encodeURIComponent(displayTime)}', '_blank')">
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
                        <span>Download E-Ticket (PDF)</span>
                      </button>

                      <div class="ticket-share-wrapper">
                        <button type="button" class="btn-ticket-share-white btn-share-trigger">
                          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="18" cy="5" r="3"></circle><circle cx="6" cy="12" r="3"></circle><circle cx="18" cy="19" r="3"></circle><line x1="8.59" y1="13.51" x2="15.42" y2="17.49"></line><line x1="15.41" y1="6.51" x2="8.59" y2="10.49"></line></svg>
                          <span>Deel Ticket</span>
                        </button>
                        <div class="ticket-share-menu">
                          <a href="https://api.whatsapp.com/send?text=${shareText}" target="_blank" rel="noopener noreferrer" class="share-option-link">
                            <span>Deel via WhatsApp</span>
                          </a>
                          <a href="mailto:?subject=${mailSubject}&body=${mailBody}" class="share-option-link">
                            <span>Deel via E-mail</span>
                          </a>
                          <button type="button" class="share-option-link" onclick="navigator.clipboard.writeText('${ticketLink}'); alert('✓ Directe ticket link gekopieerd!');">
                            <span>Kopieer Ticket Link</span>
                          </button>
                        </div>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            `;

            ticketsContainer.innerHTML += ticketHTML;
            globalTicketIndex++;
          }
        });
      }
    }

    // Auth State Controller & Dynamic Render
    const authArea = document.getElementById('portal-authenticated-area');
    const loginArea = document.getElementById('portal-login-area');
    const loginForm = document.getElementById('portal-login-form');
    const loginEmailInput = document.getElementById('login-email') as HTMLInputElement;
    const loginResInput = document.getElementById('login-res-no') as HTMLInputElement;
    const demoLoginBtn = document.getElementById('btn-quick-demo-login');
    const portalPageLogoutBtn = document.getElementById('portal-page-logout-btn');

    function checkAuthAndRender() {
      const isLoggedOut = localStorage.getItem('wf_user_logged_out') === 'true';

      if (isLoggedOut) {
        if (authArea) authArea.style.display = 'none';
        if (loginArea) loginArea.style.display = 'flex';
      } else {
        if (authArea) authArea.style.display = 'block';
        if (loginArea) loginArea.style.display = 'none';
        updatePortalUI();
      }
    }

    if (loginForm) {
      loginForm.addEventListener('submit', (e) => {
        e.preventDefault();
        const email = loginEmailInput ? loginEmailInput.value.trim() : '';
        const resNo = loginResInput ? loginResInput.value.trim() : '';
        
        localStorage.removeItem('wf_user_logged_out');
        
        const sessionData = {
          email: email || 'deondraijer@gmail.com',
          resNumber: resNo || '#WF-2026-84387',
          name: email ? (email.split('@')[0].charAt(0).toUpperCase() + email.split('@')[0].slice(1)) : 'Deon Draijer'
        };
        
        localStorage.setItem('wf_auth_session', JSON.stringify(sessionData));
        
        if (orderData) {
          orderData.email = sessionData.email;
          if (resNo) orderData.resNumber = sessionData.resNumber;
          localStorage.setItem('wf_last_order', JSON.stringify(orderData));
        }
        
        checkAuthAndRender();
        window.dispatchEvent(new Event('storage'));
      });
    }

    if (demoLoginBtn) {
      demoLoginBtn.addEventListener('click', () => {
        localStorage.removeItem('wf_user_logged_out');
        localStorage.setItem('wf_auth_session', JSON.stringify({
          email: 'deondraijer@gmail.com',
          resNumber: '#WF-2026-84387',
          name: 'Deon Draijer'
        }));
        checkAuthAndRender();
        window.dispatchEvent(new Event('storage'));
      });
    }

    if (portalPageLogoutBtn) {
      portalPageLogoutBtn.addEventListener('click', () => {
        localStorage.setItem('wf_user_logged_out', 'true');
        sessionStorage.removeItem('wf_auth_session');
        localStorage.removeItem('wf_auth_session');
        checkAuthAndRender();
        window.dispatchEvent(new Event('storage'));
      });
    }

    checkAuthAndRender();
    window.addEventListener('load', checkAuthAndRender);
    window.addEventListener('storage', checkAuthAndRender);

    // 3. Profile Save Form Submission
    const profileEditForm = document.getElementById('profile-edit-form');
    const profileSuccessBanner = document.getElementById('profile-success-banner');

    if (profileEditForm) {
      profileEditForm.addEventListener('submit', (e) => {
        e.preventDefault();

        orderData.name = profileInputName.value;
        orderData.email = profileInputEmail.value;
        orderData.phone = profileInputPhone.value;
        orderData.whiskyStyle = profileInputWhisky.value;
        
        if (orderData.isDemo) {
          delete orderData.isDemo;
          if (demoBanner) demoBanner.style.display = "none";
        }

        localStorage.setItem('wf_last_order', JSON.stringify(orderData));
        updatePortalUI();

        if (profileSuccessBanner) {
          profileSuccessBanner.style.display = "block";
          setTimeout(() => {
            profileSuccessBanner.style.display = "none";
          }, 4000);
        }
      });
    }

    // 4. Interactive Stand Map Click Logic on Account Page (1-to-1 match with standhouders page)
    const exhibitorsData = JSON.parse('{JSON.stringify(EXHIBITORS_GENT)}');

    const accountStands = document.querySelectorAll('#account-church-map .svg-stand');
    const defaultState = document.getElementById('account-default-info-state');
    const activeState = document.getElementById('account-active-info-state');

    const badgeEl = document.getElementById('account-stand-badge');
    const titleEl = document.getElementById('account-stand-title');
    const catEl = document.getElementById('account-stand-category');
    const descEl = document.getElementById('account-stand-desc');
    const brandsEl = document.getElementById('account-stand-brands-list');

    accountStands.forEach(standNode => {
      standNode.addEventListener('click', () => {
        const sId = standNode.getAttribute('data-stand');
        const match = exhibitorsData.find(e => e.id === sId);

        accountStands.forEach(s => s.classList.remove('selected-stand'));
        standNode.classList.add('selected-stand');

        if (match && defaultState && activeState) {
          defaultState.style.display = 'none';
          activeState.style.display = 'block';

          if (badgeEl) badgeEl.textContent = `STAND ${match.id}`;
          if (titleEl) titleEl.textContent = match.name;
          if (catEl) catEl.textContent = match.category.toUpperCase();
          if (descEl) descEl.textContent = match.description || "";

          if (brandsEl && match.brands) {
            brandsEl.innerHTML = match.brands.map(b => `<span class="addon-badge">${b}</span>`).join(' ');
          }
        }
      });
    });
  });
</script>
