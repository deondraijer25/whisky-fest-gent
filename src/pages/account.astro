    border-radius: 4px;
    box-shadow: 6px 6px 0px var(--text-charcoal);
    overflow: hidden;
  }

  .map-scroll-area {
    padding: 1.5rem;
    position: relative;
    overflow-x: auto;
  }

  .map-toolbar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-bottom: 2px solid var(--text-charcoal);
    padding-bottom: 1rem;
    margin-bottom: 1rem;
  }

  .toolbar-title {
    font-family: var(--font-display);
    font-size: 1.35rem;
    color: var(--text-charcoal);
  }

  .church-svg-map {
    width: 100%;
    height: auto;
    display: block;
  }

  .church-outline {
    fill: var(--bg-sand);
    stroke: var(--text-charcoal);
    stroke-width: 2.5;
  }

  .pillar {
    fill: #CBD5E1;
    stroke: #94A3B8;
    stroke-width: 1;
    opacity: 0.85;
    pointer-events: none;
  }

  .map-zone-label {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 1.1rem;
    fill: var(--text-muted);
    opacity: 0.25;
    text-anchor: middle;
    pointer-events: none;
  }

  /* --- SVG Stand Boxes (Exact match with standhouders page) --- */
  .stand-box {
    fill: var(--bg-paper-card) !important;
    stroke: var(--text-charcoal) !important;
    stroke-width: 1.8 !important;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .stand-num {
    font-family: var(--font-sans);
    font-weight: 800;
    font-size: 0.85rem;
    fill: var(--text-charcoal) !important;
    text-anchor: middle;
    pointer-events: none;
    user-select: none;
  }

  .stand-num.text-small {
    font-size: 0.75rem;
  }

  .svg-stand {
    cursor: pointer;
  }

  .svg-stand:hover .stand-box {
    fill: var(--whisky-gold-light) !important;
    stroke: var(--whisky-gold-dark) !important;
    filter: drop-shadow(0 2px 5px rgba(197, 139, 57, 0.2));
  }

  .stand-box.shop {
    fill: rgba(44, 94, 67, 0.05) !important;
    stroke: var(--success-green) !important;
  }
  .svg-stand[data-stand="S"] .stand-num {
    fill: var(--success-green) !important;
  }

  .stand-box.organisation {
    fill: rgba(143, 91, 25, 0.05) !important;
    stroke: var(--whisky-gold-dark) !important;
  }
  .svg-stand[data-stand="O"] .stand-num,
  .svg-stand[data-stand="17"] .stand-num {
    fill: var(--whisky-gold-dark) !important;
  }

  .stand-box.catering {
    fill: #FFF3CD !important;
    stroke: #856404 !important;
  }
  .svg-stand[data-stand="C"] .stand-num {
    fill: #856404 !important;
  }

  .svg-stand.selected-stand .stand-box {
    fill: var(--whisky-gold-dark) !important;
    stroke: var(--text-charcoal) !important;
    stroke-width: 2.5px !important;
  }

  .svg-stand.selected-stand .stand-num {
    fill: #ffffff !important;
    font-weight: 900;
  }

  .sidebar-exhibitors-panel {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .detail-stand-badge-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-bottom: 2px solid var(--text-charcoal);
    padding-bottom: 0.75rem;
    margin-bottom: 0.5rem;
  }

  .detail-stand-number {
    font-family: var(--font-display);
    font-size: 2.25rem;
    color: var(--whisky-gold-dark);
    line-height: 1;
  }

  .detail-content-block {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }

  .detail-brands-box {
    border-top: 1px dotted var(--border-color-dark);
    padding-top: 0.85rem;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .brands-label {
    font-family: var(--font-sans);
    font-weight: 800;
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--text-muted);
  }

  .brands-list-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  .brand-tag {
    background-color: var(--bg-sand);
    border: 1px solid var(--border-color-dark);
    color: var(--text-charcoal);
    font-family: var(--font-sans);
    font-weight: 700;
    font-size: 0.75rem;
    padding: 0.25rem 0.5rem;
    border-radius: 3px;
  }

  .event-info-grid-three {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.75rem;
    align-items: stretch;
  }

  @media (max-width: 1024px) {
    .map-detail-layout,
    .event-info-grid-three {
      grid-template-columns: 1fr;
    }
  }

  .tickets-main-column {
    display: flex;
    flex-direction: column;
    gap: 2rem;
    min-width: 0;
  }

  /* --- Sidebar Cards --- */
  .portal-sidebar-grid {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .sidebar-card {
    background-color: var(--bg-paper-card);
    border: 2px solid var(--text-charcoal);
    border-radius: 10px;
    box-shadow: 0 10px 30px rgba(0,0,0,0.04);
    overflow: hidden;
  }

  .card-padded {
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .card-inner-title {
    font-family: var(--font-display);
    font-size: 1.35rem;
    color: var(--text-charcoal);
    margin: 0;
  }

  .sidebar-card-text {
    font-family: var(--font-serif);
    font-size: 0.9rem;
    line-height: 1.5;
    color: var(--text-charcoal);
  }

  .sidebar-card-subtext {
    font-family: var(--font-serif);
    font-size: 0.85rem;
    line-height: 1.5;
    color: var(--text-muted);
  }

  .sidebar-actions-list {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .sidebar-links-group {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .action-note-text {
    font-family: var(--font-serif);
    font-size: 0.8rem;
    color: var(--text-muted);
    line-height: 1.4;
    font-style: italic;
    margin: 0;
  }

  .btn-sidebar-action {
    width: 100%;
    padding: 0.85rem 1rem;
    font-family: var(--font-sans);
    font-weight: 800;
    font-size: 0.9rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    border-radius: 6px;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  /* --- Ticket Stub Card Styling --- */
  
    /* --- BALANCED 3-LAYER TICKET CARD --- */
  .ticket-envelope {
    background-color: #FFFFFF;
    border: 2px solid var(--text-charcoal);
    border-radius: 4px;
    box-shadow: 5px 5px 0px var(--text-charcoal);
    overflow: hidden;
    position: relative;
  }

  .ticket-stub-large {
    display: grid;
    grid-template-columns: 185px 1fr;
    min-height: 240px;
    background: #FFFFFF;
  }

  @media (max-width: 768px) {
    .ticket-stub-large {
      grid-template-columns: 1fr;
    }
    .ticket-right-stub {
      border-right: none !important;
      border-bottom: 2px dashed var(--text-charcoal) !important;
    }
  }

  .ticket-right-stub {
    background-color: #FAF7F2;
    border-right: 2px dashed var(--text-charcoal);
    padding: 1.5rem 1rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: space-between;
    text-align: center;
    gap: 0.5rem;
  }

  .scan-label {
    font-family: var(--font-sans);
    font-size: 0.65rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    color: var(--text-muted);
    text-transform: uppercase;
  }

  .qr-code-holder {
    background-color: #FFFFFF;
    padding: 8px;
    border: 1.5px solid var(--border-color, #E2D9CC);
    border-radius: 4px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .scan-instructions {
    font-family: var(--font-sans);
    font-size: 0.72rem;
    font-weight: 800;
    color: var(--whisky-gold-dark, #8B5A1B);
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .scan-res-hash {
    font-family: monospace;
    font-size: 0.75rem;
    color: var(--text-charcoal);
    font-weight: 800;
  }

  .ticket-left-stub {
    padding: 1.75rem 2.25rem;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    position: relative;
    background-color: #FFFFFF;
    gap: 1.25rem;
  }

  .ticket-watermark {
    position: absolute;
    right: 1.5rem;
    bottom: -0.5rem;
    font-family: var(--font-display);
    font-size: 8rem;
    color: rgba(29, 28, 26, 0.03);
    line-height: 1;
    pointer-events: none;
    user-select: none;
  }

  /* 1. Header Row */
  .ticket-header-row {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .ticket-title-block {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .ticket-session-title {
    font-family: var(--font-display);
    font-size: 2.1rem;
    color: var(--text-charcoal);
    margin: 0;
    line-height: 1.15;
    letter-spacing: 0.02em;
  }

  .ticket-schedule-text {
    font-family: var(--font-sans);
    font-size: 0.88rem;
    font-weight: 800;
    color: var(--whisky-gold-dark, #8B5A1B);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    margin: 0;
  }

  .ticket-badges-block {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .ticket-status-tag {
    font-family: var(--font-sans);
    font-size: 0.72rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    background: rgba(30, 58, 138, 0.08);
    color: #1E3A8A;
    border: 1px solid rgba(30, 58, 138, 0.3);
    padding: 0.35rem 0.75rem;
    border-radius: 3px;
    white-space: nowrap;
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
  }

  .ticket-qty-tag {
    font-family: var(--font-sans);
    font-size: 0.72rem;
    font-weight: 800;
    background: rgba(140, 110, 70, 0.1);
    color: var(--whisky-gold-dark);
    border: 1px solid rgba(140, 110, 70, 0.25);
    padding: 0.35rem 0.65rem;
    border-radius: 3px;
    white-space: nowrap;
  }

  /* 2. Middle Row: 3-Column Meta Grid */
  .ticket-meta-trio {
    display: grid;
    grid-template-columns: 1.2fr 1.2fr 1fr;
    gap: 1.25rem;
    background: #FAF7F2;
    border: 1px solid var(--border-color, #E2D9CC);
    border-radius: 4px;
    padding: 0.85rem 1.25rem;
  }

  @media (max-width: 600px) {
    .ticket-meta-trio {
      grid-template-columns: 1fr;
      gap: 0.75rem;
    }
  }

  .meta-col {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  .meta-col-label {
    font-family: var(--font-sans);
    font-size: 0.68rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--text-muted, #7A7268);
  }

  .meta-col-val {
    font-family: var(--font-sans);
    font-size: 0.95rem;
    font-weight: 800;
    color: var(--text-charcoal, #1D1C1A);
    line-height: 1.25;
  }

  .meta-col-val.font-mono {
    font-family: monospace;
    color: var(--whisky-gold-dark, #8B5A1B);
    font-size: 0.98rem;
  }

  /* 3. Bottom Row: Action Buttons */
  .ticket-actions-row {
    display: flex;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .btn-ticket-download-gold {
    background-color: var(--whisky-gold, #C58B39) !important;
    color: #171614 !important;
    border: 2px solid var(--text-charcoal) !important;
    padding: 0.75rem 1.4rem !important;
    font-family: var(--font-sans) !important;
    font-size: 0.85rem !important;
    font-weight: 800 !important;
    text-transform: uppercase !important;
    letter-spacing: 0.04em !important;
    border-radius: 3px !important;
    cursor: pointer !important;
    display: inline-flex !important;
    align-items: center !important;
    gap: 0.5rem !important;
    box-shadow: 3px 3px 0px var(--text-charcoal) !important;
    transition: all 0.2s ease !important;
    text-decoration: none !important;
  }

  .btn-ticket-download-gold:hover {
    transform: translate(-1px, -1px) !important;
    box-shadow: 4px 4px 0px var(--text-charcoal) !important;
    background-color: var(--whisky-gold-light, #DFC598) !important;
  }

  .btn-ticket-share-white {
    background-color: #FFFFFF !important;
    color: var(--text-charcoal) !important;
    border: 2px solid var(--text-charcoal) !important;
    padding: 0.75rem 1.25rem !important;
    font-family: var(--font-sans) !important;
    font-size: 0.85rem !important;
    font-weight: 800 !important;
    border-radius: 3px !important;
    cursor: pointer !important;
    display: inline-flex !important;
    align-items: center !important;
    gap: 0.45rem !important;
    box-shadow: 3px 3px 0px var(--text-charcoal) !important;
    transition: all 0.2s ease !important;
  }

  .btn-ticket-share-white:hover {
    transform: translate(-1px, -1px) !important;
    box-shadow: 4px 4px 0px var(--text-charcoal) !important;
    background-color: var(--bg-sand) !important;
  }

  .ticket-share-wrapper {
    position: relative;
  }

  .ticket-share-menu {
    position: absolute;
    bottom: calc(100% + 8px);
    left: 0;
    background: #FFFFFF;
    border: 2px solid var(--text-charcoal);
    border-radius: 4px;
    box-shadow: 4px 4px 0px var(--text-charcoal);
    padding: 0.5rem;
    display: none;
    flex-direction: column;
    gap: 0.35rem;
    min-width: 200px;
    z-index: 100;
  }

  .ticket-share-wrapper.open .ticket-share-menu,
  .ticket-share-menu.active {
    display: flex;
  }

  /* --- Form Inputs Styling --- */
  .vintage-form {
    display: flex;
    flex-direction: column;
    gap: 1.1rem;
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .form-label {
    font-family: var(--font-sans);
    font-weight: 800;
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--text-charcoal);
  }

  .form-control {
    background-color: var(--bg-parchment);
    border: 2px solid var(--text-charcoal);
    border-radius: 6px;
    padding: 0.75rem 1rem;
    font-family: var(--font-sans);
    font-size: 0.95rem;
    color: var(--text-charcoal);
    outline: none;
    transition: box-shadow 0.2s;
  }

  .form-control:focus {
    box-shadow: 0px 0px 0px 3px var(--whisky-gold-trans);
  }

  /* --- Receipt Table styling --- */
  .receipt-table-wrapper {
    overflow-x: auto;
    width: 100%;
  }

  .receipt-table {
    width: 100%;
    border-collapse: collapse;
    font-family: var(--font-sans);
    font-size: 0.9rem;
    text-align: left;
  }

  .receipt-table th {
    border-bottom: 2px solid var(--text-charcoal);
    padding: 0.85rem 0.65rem;
    font-weight: 800;
    text-transform: uppercase;
    font-size: 0.75rem;
    color: var(--text-muted);
  }

  .receipt-table td {
    padding: 1.1rem 0.65rem;
    border-bottom: 1px dotted var(--border-color-dark);
  }

  .status-badge {
    font-size: 0.75rem;
    font-weight: 800;
    text-transform: uppercase;
    padding: 0.3rem 0.65rem;
    border-radius: 4px;
    letter-spacing: 0.05em;
    display: inline-block;
  }

  .status-badge.paid {
    background-color: rgba(30, 58, 138, 0.08);
    color: #1E3A8A;
    border: 1px solid rgba(30, 58, 138, 0.25);
  }

  /* --- Receipt Mobile Card View Styles --- */
  .receipt-mobile-card-view {
    display: none;
    width: 100%;
  }

  .rc-mobile-card {
    background: #FFFFFF;
    border: 1.5px solid var(--border-color-dark, #CBD5E1);
    border-radius: 8px;
    padding: 1.25rem 1rem;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.04);
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    box-sizing: border-box;
    width: 100%;
  }

  .rc-mobile-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    width: 100%;
  }

  .rc-mobile-head {
    border-bottom: 1px dashed rgba(30, 58, 138, 0.25);
    padding-bottom: 0.75rem;
  }

  .rc-mobile-col {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .rc-mobile-right {
    align-items: flex-end;
    text-align: right;
  }

  .rc-label {
    font-family: var(--font-sans);
    font-size: 0.72rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--text-muted, #334155);
  }

  .rc-res-val {
    font-size: 1.05rem;
    font-weight: 800;
    color: var(--text-charcoal, #0F172A);
    letter-spacing: 0.02em;
  }

  .rc-date-val {
    font-family: var(--font-serif);
    font-size: 0.92rem;
    color: var(--text-charcoal, #0F172A);
  }

  .rc-price-val {
    font-family: var(--font-sans);
    font-size: 1.15rem;
    font-weight: 800;
    color: #1E3A8A;
  }

  /* --- Event booklet layout --- */
  .program-guide-booklet {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .booklet-chapter-title {
    font-family: var(--font-sans);
    font-weight: 800;
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: #1E3A8A;
    margin: 0;
  }

  .booklet-list {
    margin: 0.65rem 0 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
  }

  .booklet-list li {
    font-family: var(--font-serif);
    font-size: 0.9rem;
    line-height: 1.5;
    color: var(--text-charcoal);
    position: relative;
    padding-left: 1.25rem;
  }

  .booklet-list li::before {
    content: "◆";
    position: absolute;
    left: 0;
    top: 0;
